// Rows of the folder sidebar and the message list.

import { Palette } from "std-widgets.slint";
import { FolderItem, MessageItem, ConversationItem } from "types.slint";
import { Theme, Divider } from "widgets.slint";

export component FolderRow inherits Rectangle {
    in property <FolderItem> folder;
    in property <bool> selected;
    callback clicked();
    accessible-role: list-item;
    accessible-label: (folder.role == "account" ? "Account " : "Folder ") + folder.label;
    accessible-action-default => { root.clicked(); }
    height: 30px;
    border-radius: 6px;
    background: selected ? Theme.selection : touch.has-hover ? Palette.foreground.with-alpha(0.05) : transparent;
    animate background { duration: 120ms; easing: ease-out; }
    HorizontalLayout {
        padding-left: 10px + folder.depth * 14px;
        padding-right: 10px;
        spacing: 8px;
        // Account heading: the same bar that marks the account's messages in the list.
        if folder.role == "account": Rectangle {
            width: 4px;
            border-radius: 2px;
            background: folder.color;
        }
        if folder.role != "account": Image {
            width: 16px;
            colorize: Theme.muted;
            source: folder.role == "inbox" ? @image-url("icons/inbox.svg")
                : folder.role == "unified" ? @image-url("icons/mails.svg")
                : folder.role == "sent" ? @image-url("icons/send.svg")
                : folder.role == "drafts" ? @image-url("icons/file-pen-line.svg")
                : folder.role == "trash" ? @image-url("icons/trash.svg")
                : folder.role == "junk" ? @image-url("icons/shield-alert.svg")
                : folder.role == "archive" ? @image-url("icons/archive.svg")
                : folder.role == "all" ? @image-url("icons/mails.svg")
                : folder.role == "flagged" ? @image-url("icons/star.svg")
                : @image-url("icons/folder.svg");
        }
        Text {
            text: folder.label;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            font-weight: folder.unread > 0 || folder.role == "account" ? 600 : 400;
            color: folder.role == "account" ? Theme.muted : Palette.foreground;
        }
        if folder.unread > 0: Text {
            text: folder.unread;
            vertical-alignment: center;
            color: Theme.muted;
            font-size: 12px;
        }
    }
    touch := TouchArea {
        clicked => root.clicked();
    }
}

/// One message on the timeline of an open conversation in the list.
export component TimelineItem inherits Rectangle {
    in property <ConversationItem> item;
    in property <bool> current;
    in property <bool> first;
    in property <bool> last;
    in property <color> line-color;
    callback clicked();
    accessible-role: list-item;
    accessible-label: "Conversation: " + item.sender + ", " + item.date;
    accessible-action-default => { root.clicked(); }
    height: 30px;
    border-radius: 4px;
    background: current ? Theme.selection : touch.has-hover ? Palette.foreground.with-alpha(0.05) : transparent;
    animate background { duration: 120ms; easing: ease-out; }
    // The line runs through all items; it starts at the first dot and ends at the last.
    Rectangle {
        x: 11px;
        y: root.first ? root.height / 2 : 0;
        width: 2px;
        height: (root.first || root.last) ? root.height / 2 : root.height;
        background: root.line-color;
    }
    Rectangle {
        x: 12px - self.width / 2;
        width: root.current ? 10px : 8px;
        height: self.width;
        border-radius: self.width / 2;
        background: item.seen ? Palette.background : root.line-color;
        border-width: 2px;
        border-color: root.line-color;
    }
    HorizontalLayout {
        padding-left: 26px;
        padding-right: 6px;
        spacing: 8px;
        Text {
            text: item.sender;
            font-weight: item.seen ? 400 : 700;
            vertical-alignment: center;
            width: 90px;
            overflow: elide;
        }
        Text {
            text: item.snippet;
            color: Theme.muted;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Text {
            text: item.date;
            color: Theme.muted;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        clicked => root.clicked();
    }
}

export component MessageRow inherits Rectangle {
    in property <MessageItem> msg;
    in property <bool> selected;
    /// Messages of the open conversation, oldest first; shown under the selected row.
    in property <[ConversationItem]> thread;
    in property <int> thread-current: -1;
    /// Some row is ticked: every row shows its tick box instead of the unread dot.
    in property <bool> selecting;
    callback clicked();
    callback thread-clicked(int);
    /// Tick box tapped, or the row long-pressed.
    callback check-toggled();
    /// Phones: swiping the row right archives it, left deletes it.
    in property <bool> swipeable;
    callback swiped(/* archive */ bool);
    property <length> offset: swipe.swiping ? swipe.current-position.x - swipe.pressed-position.x : 0;
    // Far enough that letting go acts; a short swipe springs back.
    property <bool> armed: abs(root.offset) > root.width * 0.35;
    property <bool> long-pressed;
    property <bool> expanded: root.selected && root.thread.length > 1;
    // The mini timeline; the unfolded one replaces it.
    property <bool> strip: root.msg.dots.length > 1 && !root.expanded;
    property <length> head: root.strip ? 90px : 74px;
    property <color> line-color: root.msg.color.alpha > 0 ? root.msg.color : Theme.accent;
    accessible-role: list-item;
    accessible-label: msg.sender + ": " + msg.subject;
    accessible-action-default => { root.clicked(); }
    height: root.head + (root.expanded ? root.thread.length * 30px + 8px : 0px);
    // Revealed behind the row while it is swiped: green archives, red deletes.
    background: root.offset > 0 ? #2e9d5b : #d93f3f;
    if root.offset != 0: Image {
        x: root.offset > 0 ? 20px : root.width - 20px - self.width;
        y: (root.head - self.height) / 2;
        width: 24px;
        source: root.offset > 0 ? @image-url("icons/archive.svg") : @image-url("icons/trash.svg");
        colorize: white;
        opacity: root.armed ? 1 : 0.5;
    }
    swipe := SwipeGestureHandler {
        enabled: root.swipeable;
        handle-swipe-left: true;
        handle-swipe-right: true;
        // Released after `swiping` ends: measure from the positions.
        swiped => {
            if abs(self.current-position.x - self.pressed-position.x) > root.width * 0.35 {
                root.swiped(self.current-position.x > self.pressed-position.x);
            }
        }
        Rectangle {
            x: root.offset;
            width: root.width;
            height: root.height;
            background: Palette.background;
            animate x { duration: swipe.swiping ? 0ms : 150ms; }
            Rectangle {
                // Expanded, the open message is marked on the timeline instead.
                background: root.expanded ? Palette.foreground.with-alpha(0.03)
                    : root.selected ? Theme.selection
                    : touch.has-hover ? Palette.foreground.with-alpha(0.04) : transparent;
                animate background { duration: 120ms; easing: ease-out; }
            }
            HorizontalLayout {
                height: root.head;
                y: 0;
                padding: 10px;
                padding-left: 6px;
                spacing: 6px;
                Rectangle {
                    width: 18px;
                    if !root.selecting: Rectangle {
                        x: 5px;
                        y: 6px;
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: msg.seen ? transparent : Theme.unread-dot;
                    }
                    if root.selecting: Rectangle {
                        y: 2px;
                        width: 18px;
                        height: 18px;
                        border-radius: 9px;
                        border-width: 2px;
                        border-color: Theme.accent;
                        background: msg.checked ? Theme.accent : transparent;
                        if msg.checked: Path {
                            width: 12px;
                            height: 12px;
                            commands: "M 2 6 L 5 9 L 10 3";
                            stroke: white;
                            stroke-width: 2px;
                            fill: transparent;
                        }
                    }
                }
                VerticalLayout {
                    spacing: 2px;
                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: msg.sender;
                            font-weight: msg.seen ? 400 : 700;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        if msg.count > 1: Text {
                            text: msg.count;
                            color: Theme.muted;
                            font-size: 12px;
                            accessible-label: msg.count + " messages";
                        }
                        if msg.answered: Image {
                            source: @image-url("icons/reply.svg");
                            colorize: Theme.muted;
                            width: 14px;
                            accessible-role: image;
                            accessible-label: "replied";
                        }
                        if msg.attachments: Image {
                            source: @image-url("icons/paperclip.svg");
                            colorize: Theme.muted;
                            width: 14px;
                            accessible-role: image;
                            accessible-label: "has attachments";
                        }
                        if msg.flagged: Image {
                            source: @image-url("icons/star.svg");
                            colorize: Theme.flag;
                            width: 14px;
                            accessible-role: image;
                            accessible-label: "flagged";
                        }
                        Text {
                            text: msg.date;
                            color: Theme.muted;
                            font-size: 12px;
                        }
                    }
                    Text {
                        text: msg.subject;
                        font-weight: msg.seen ? 400 : 600;
                        overflow: elide;
                    }
                    Text {
                        text: msg.snippet;
                        color: Theme.muted;
                        font-size: 12px;
                        overflow: elide;
                    }
                    if root.strip: HorizontalLayout {
                        height: 12px;
                        alignment: start;
                        spacing: 4px;
                        if msg.count > msg.dots.length: Text {
                            text: "+" + (msg.count - msg.dots.length);
                            color: Theme.muted;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                        HorizontalLayout {
                            // Hollow dots are read, filled ones unread, like the unfolded timeline.
                            for seen[k] in msg.dots: Rectangle {
                                width: k == 0 ? 8px : 22px;
                                if k > 0: Rectangle {
                                    x: 0;
                                    y: (parent.height - self.height) / 2;
                                    width: parent.width - 8px;
                                    height: 2px;
                                    background: root.line-color;
                                }
                                Rectangle {
                                    x: parent.width - 8px;
                                    y: (parent.height - self.height) / 2;
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    border-width: 2px;
                                    border-color: root.line-color;
                                    background: seen ? Palette.background : root.line-color;
                                }
                            }
                        }
                    }
                }
            }
            // Which account the message belongs to.
            Rectangle {
                x: 0;
                y: 0;
                width: 4px;
                height: parent.height;
                background: msg.color;
            }
            Divider {
                y: parent.height - 1px;
                height: 1px;
            }
            touch := TouchArea {
                y: 0;
                height: root.head;
                clicked => {
                    // The release that ends a long press is not a click.
                    if !root.long-pressed {
                        root.clicked();
                    }
                }
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        root.long-pressed = false;
                    }
                }
            }
            Timer {
                interval: 500ms;
                running: touch.pressed && !root.long-pressed;
                triggered => {
                    root.long-pressed = true;
                    root.check-toggled();
                }
            }
            // The left edge ticks the row, like an avatar in other mail apps.
            TouchArea {
                x: 0;
                y: 0;
                width: 30px;
                height: root.head;
                accessible-role: checkbox;
                accessible-label: "Select " + msg.sender + ": " + msg.subject;
                accessible-checked: msg.checked;
                accessible-action-default => { root.check-toggled(); }
                clicked => root.check-toggled();
            }
            if root.expanded: VerticalLayout {
                y: root.head;
                height: root.height - root.head;
                padding-left: 12px;
                padding-right: 8px;
                padding-bottom: 8px;
                for item[i] in root.thread: TimelineItem {
                    item: item;
                    current: i == root.thread-current;
                    first: i == 0;
                    last: i == root.thread.length - 1;
                    line-color: root.line-color;
                    clicked => root.thread-clicked(i);
                }
            }
        }
    }
}
