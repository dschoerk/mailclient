// Rows of the folder sidebar and the message list.

import { Palette } from "std-widgets.slint";
import { FolderItem, MessageItem, ConversationItem } from "types.slint";
import { Theme, Divider } from "widgets.slint";

/// A button on the strip a removed row leaves: white outline on the strip's color.
component StripButton inherits Rectangle {
    in property <string> text;
    callback clicked();
    width: label.preferred-width + 28px;
    height: 34px;
    border-radius: 17px;
    border-width: 1px;
    border-color: white;
    background: touch.pressed ? #ffffff40 : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    label := Text {
        text: root.text;
        color: white;
        font-size: 13px;
        font-weight: 600;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

/// Prototype: how a released swipe is judged. Tuned live in the Swipe lab (Settings); every row uses it.
export global SwipeTuning {
    /// 0 distance only, 1 distance or fling, 2 projected end (where the row would coast to).
    in-out property <int> mode: 2;
    /// Of the row width.
    in-out property <float> distance: 0.03;
    /// Logical px per ms; 1.0 is 1000 px/s.
    in-out property <float> fling-speed: 0.5;
    /// A fling must still travel this much of the row width.
    in-out property <float> min-fling: 0.1;
    /// Mode 2: the release speed carried on for this long, in ms.
    in-out property <float> projection: 0;
    /// Dragged this far (of the row width) and let go there: more options (Move to) instead.
    in-out property <float> more-distance: 0.3;
    /// Released faster than this (px per ms), it is a fling: archive or delete, never more options.
    in-out property <float> more-max-speed: 2.0;
    /// A counted swipe slides the row out before it goes.
    in-out property <bool> fly-out: true;
    /// The last release, for the lab's readout.
    in-out property <string> last: "Swipe a row";
}

export component FolderRow inherits Rectangle {
    in property <FolderItem> folder;
    in property <bool> selected;
    callback clicked();
    accessible-role: list-item;
    accessible-label: (folder.role == "account" ? "Account " : "Folder ") + folder.label;
    accessible-action-default => { root.clicked(); }
    height: 30px;
    border-radius: 6px;
    background: selected ? Theme.selection : touch.has-hover ? Palette.foreground.with-alpha(0.05) : transparent;
    animate background { duration: 120ms; easing: ease-out; }
    HorizontalLayout {
        padding-left: 10px + folder.depth * 14px;
        padding-right: 10px;
        spacing: 8px;
        // Account heading: the same bar that marks the account's messages in the list.
        if folder.role == "account": Rectangle {
            width: 4px;
            border-radius: 2px;
            background: folder.color;
        }
        if folder.role != "account": Image {
            width: 16px;
            colorize: Theme.muted;
            source: folder.role == "inbox" ? @image-url("icons/inbox.svg")
                : folder.role == "unified" ? @image-url("icons/mails.svg")
                : folder.role == "sent" ? @image-url("icons/send.svg")
                : folder.role == "drafts" ? @image-url("icons/file-pen-line.svg")
                : folder.role == "trash" ? @image-url("icons/trash.svg")
                : folder.role == "junk" ? @image-url("icons/shield-alert.svg")
                : folder.role == "archive" ? @image-url("icons/archive.svg")
                : folder.role == "all" ? @image-url("icons/mails.svg")
                : folder.role == "flagged" ? @image-url("icons/star.svg")
                : @image-url("icons/folder.svg");
        }
        Text {
            text: folder.label;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            font-weight: folder.unread > 0 || folder.role == "account" ? 600 : 400;
            color: folder.role == "account" ? Theme.muted : Palette.foreground;
        }
        if folder.unread > 0: Text {
            text: folder.unread;
            vertical-alignment: center;
            color: Theme.muted;
            font-size: 12px;
        }
    }
    touch := TouchArea {
        clicked => root.clicked();
    }
}

/// One message on the timeline of an open conversation in the list.
export component TimelineItem inherits Rectangle {
    in property <ConversationItem> item;
    in property <bool> current;
    in property <bool> first;
    in property <bool> last;
    in property <color> line-color;
    callback clicked();
    accessible-role: list-item;
    accessible-label: "Conversation: " + item.sender + ", " + item.date;
    accessible-description: current ? "current" : "";
    accessible-action-default => { root.clicked(); }
    height: 30px;
    border-radius: 4px;
    background: current ? Theme.selection : touch.has-hover ? Palette.foreground.with-alpha(0.05) : transparent;
    animate background { duration: 120ms; easing: ease-out; }
    // The line runs through all items; it starts at the first dot and ends at the last.
    Rectangle {
        x: 11px;
        y: root.first ? root.height / 2 : 0;
        width: 2px;
        height: (root.first || root.last) ? root.height / 2 : root.height;
        background: root.line-color;
    }
    Rectangle {
        x: 12px - self.width / 2;
        width: root.current ? 10px : 8px;
        height: self.width;
        border-radius: self.width / 2;
        background: item.seen ? Palette.background : root.line-color;
        border-width: 2px;
        border-color: root.line-color;
    }
    HorizontalLayout {
        padding-left: 26px;
        padding-right: 6px;
        spacing: 8px;
        Text {
            text: item.sender;
            font-weight: item.seen ? 400 : 700;
            vertical-alignment: center;
            width: 90px;
            overflow: elide;
        }
        Text {
            text: item.snippet;
            color: Theme.muted;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Text {
            text: item.date;
            color: Theme.muted;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        clicked => root.clicked();
    }
}

export component MessageRow inherits Rectangle {
    in property <MessageItem> msg;
    in property <bool> selected;
    /// Messages of the open conversation, oldest first; shown under the selected row.
    in property <[ConversationItem]> thread;
    in property <int> thread-current: -1;
    /// Some row is ticked: every row shows its tick box instead of the unread dot.
    in property <bool> selecting;
    callback clicked();
    callback thread-clicked(int);
    /// Tick box tapped, or the row long-pressed.
    callback check-toggled();
    /// The row was long-pressed (phones vibrate).
    callback held();
    /// Phones: swiping the row right archives it, left deletes it.
    in property <bool> swipeable;
    callback swiped(/* archive */ bool);
    /// Dragged far and let go there: show more options (Move to).
    callback more();
    /// The strip's Undo.
    callback undo();
    /// The strip's Find similar: the sender's other mail.
    callback similar();
    /// The drag just reached the more-options zone (phones vibrate).
    callback far-reached();
    property <bool> removed: root.msg.removed != "";
    // Dragged into the more-options zone.
    // Once flying, the decision says it (an archive flies past that line too).
    // While dragging, only a finger moving slowly there: a fling passing through stays green or red.
    property <bool> far: root.flying != 0 ? abs(root.flying) == 2
        : abs(front.x) > root.width * SwipeTuning.more-distance && abs(root.speed) < SwipeTuning.more-max-speed;
    changed far => {
        if root.far && root.flying == 0 {
            root.far-reached();
        }
    }
    property <length> offset: swipe.swiping ? swipe.current-position.x - swipe.pressed-position.x : 0;
    // Far enough that letting go acts; a short swipe springs back.
    property <bool> armed: root.flying != 0 || abs(root.offset) > root.width * SwipeTuning.distance;
    // Finger speed while swiping, in px per ms (signed), over the last 25 to 50 ms:
    // measured from an older sample that trails the finger, not between single events.
    property <length> anchor-x;
    property <duration> anchor-t;
    property <length> mid-x;
    property <duration> mid-t;
    property <float> speed;
    property <bool> tracking;
    // A counted swipe: the row slides out that way (1 archive, -1 delete), then `swiped` fires.
    property <int> flying;
    property <bool> flown;
    // Where the row rests when nobody holds it.
    property <length> rest: root.flying != 0 ? (abs(root.flying) == 2 ? root.flying / 2 : root.flying) * root.width : 0;
    // After letting go the row glides to `rest`: it leaves at the finger's speed and slows to a stop.
    property <bool> gliding;
    property <length> glide-from;
    // The start speed times the glide time, in px.
    property <float> glide-move;
    property <duration> glide-time;
    property <duration> glide-start;
    // How far through the glide, 0 to 1. Reads the animation tick only while gliding, so an idle row draws no frames.
    property <float> glide-s: root.gliding ? min(1, (animation-tick() - root.glide-start) / root.glide-time) : 1;
    changed msg => {
        root.gliding = false;
        root.flying = 0;
        root.flown = false;
    }

    function track(x: length) {
        let now = animation-tick();
        if !root.tracking {
            root.tracking = true;
            root.gliding = false;
            root.speed = 0;
            // From here, not the press: the first 100 ms of the finger's travel arrive in one jump.
            root.anchor-x = x;
            root.anchor-t = now;
            root.mid-x = x;
            root.mid-t = now;
        }
        if now - root.mid-t >= 25ms {
            root.anchor-x = root.mid-x;
            root.anchor-t = root.mid-t;
            root.mid-x = x;
            root.mid-t = now;
        }
        root.speed = root.speed-at(x);
    }

    // Speed from the trailing sample to `x` now; a finger that stopped before letting go has none left.
    function speed-at(x: length) -> float {
        let dt = (animation-tick() - root.anchor-t) / 1ms;
        return dt <= 0 ? root.speed : (x - root.anchor-x) / 1px / dt;
    }

    // Let go at `from` moving `v` px per ms: glide to `rest` (a cubic that starts at that speed and ends still).
    function glide(from: length, v: float) {
        let d = (root.rest - from) / 1px;
        if d == 0 {
            root.gliding = false;
            return;
        }
        let toward = d > 0 ? v : -v;
        // Slowing evenly to a stop covers the distance in twice the time the start speed would.
        let t = max(100, min(250, 2 * abs(d) / max(toward, 1)));
        // More start speed than that overshoots: allow 3x the distance toward `rest`, 1x away from it.
        let limit = (toward > 0 ? 3 : 1) * abs(d);
        root.glide-move = max(-limit, min(limit, v * t));
        root.glide-from = from;
        root.glide-time = t * 1ms;
        root.glide-start = animation-tick();
        root.gliding = true;
    }

    // 1 archive, -1 delete, 0 spring back. `v`: release speed in px per ms.
    function decide(dx: length, v: float) -> int {
        let w = root.width / 1px;
        let d = dx / 1px;
        let dir = d > 0 ? 1 : -1;
        let along = v * dir;
        let end = d + v * SwipeTuning.projection;
        // Held far out and let go there (no fling): more options, whichever side.
        let more = abs(d) > w * SwipeTuning.more-distance && abs(v) < SwipeTuning.more-max-speed;
        let result = more ? 2 * dir : SwipeTuning.mode == 0 ? (abs(d) > w * SwipeTuning.distance ? dir : 0)
            : SwipeTuning.mode == 1 ? (along < -SwipeTuning.fling-speed ? 0
                : abs(d) > w * SwipeTuning.distance || (along > SwipeTuning.fling-speed && abs(d) > w * SwipeTuning.min-fling) ? dir : 0)
            : (end * dir > 0 && abs(end) > w * SwipeTuning.distance ? dir : 0);
        SwipeTuning.last = "moved \{round(abs(d) / w * 100)}% · speed \{round(v * 100) / 100} px/ms · coast to \{round(end / w * 100)}% → "
            + (abs(result) == 2 ? "MORE" : result > 0 ? "ARCHIVE" : result < 0 ? "DELETE" : "back");
        return result;
    }

    function act(dir: int) {
        if dir == 0 {
            return;
        }
        if SwipeTuning.fly-out {
            root.flying = dir;
        } else if abs(dir) == 2 {
            root.more();
        } else {
            root.swiped(dir > 0);
        }
    }
    property <bool> long-pressed;
    property <bool> expanded: root.selected && root.thread.length > 1;
    // The mini timeline; the unfolded one replaces it.
    property <bool> strip: root.msg.dots.length > 1 && !root.expanded;
    property <length> head: root.strip ? 90px : 74px;
    property <color> line-color: root.msg.color.alpha > 0 ? root.msg.color : Theme.accent;
    accessible-role: list-item;
    accessible-label: (root.removed ? msg.removed-text + " " : "") + msg.sender + ": " + msg.subject;
    accessible-action-default => { root.clicked(); }
    height: root.head + (root.expanded ? root.thread.length * 30px + 8px : 0px);
    // Revealed behind the row while it is swiped: green archives, red deletes, blue (far) more options.
    // The row's drawn position, not `offset`: after letting go it still slides back.
    background: root.removed ? (root.msg.removed == "archive" ? #2e9d5b : root.msg.removed == "delete" ? #d93f3f : #3b6fd4)
        : root.far ? #3b6fd4 : front.x > 0 ? #2e9d5b : #d93f3f;
    animate background { duration: 120ms; }
    if front.x != 0 && !root.removed: Image {
        x: front.x > 0 ? 20px : root.width - 20px - self.width;
        y: (root.head - self.height) / 2;
        width: 24px;
        source: root.far ? @image-url("icons/folder.svg") : front.x > 0 ? @image-url("icons/archive.svg") : @image-url("icons/trash.svg");
        colorize: white;
        opacity: root.armed ? 1 : 0.5;
    }
    // Undoable a while after it went: a ghost of the row, and Undo.
    if root.removed: HorizontalLayout {
        height: root.head;
        y: 0;
        padding-left: 20px;
        padding-right: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.msg.removed-text;
                color: white;
                font-size: 13px;
                font-weight: 600;
            }
            Text {
                text: root.msg.sender + " · " + root.msg.subject;
                color: white;
                opacity: 0.65;
                font-size: 12px;
                overflow: elide;
            }
        }
        StripButton {
            y: (root.head - self.height) / 2;
            text: "Find similar";
            clicked => { root.similar(); }
        }
        StripButton {
            y: (root.head - self.height) / 2;
            text: "Undo";
            clicked => { root.undo(); }
        }
    }
    swipe := SwipeGestureHandler {
        enabled: root.swipeable && !root.removed;
        handle-swipe-left: true;
        handle-swipe-right: true;
        moved => { root.track(self.current-position.x); }
        cancelled => {
            root.tracking = false;
            root.glide(self.current-position.x - self.pressed-position.x, 0);
        }
        // Released after `swiping` ends: measure from the positions.
        swiped => {
            root.tracking = false;
            let dx = self.current-position.x - self.pressed-position.x;
            let v = root.speed-at(self.current-position.x);
            root.act(root.decide(dx, v));
            root.glide(dx, v);
        }
        Timer {
            interval: root.glide-time;
            running: root.gliding;
            triggered => {
                root.gliding = false;
                if root.flying != 0 && !root.flown {
                    root.flown = true;
                    if abs(root.flying) == 2 {
                        root.more();
                    } else {
                        root.swiped(root.flying > 0);
                    }
                }
            }
        }
        // Still here after flying out (an error, or the lab): slide back.
        Timer {
            interval: 1200ms;
            running: root.flown;
            triggered => {
                let from = root.rest;
                root.flying = 0;
                root.flown = false;
                root.glide(from, 0);
            }
        }
        front := Rectangle {
            visible: !root.removed;
            x: root.gliding ? root.glide-from * (2 * root.glide-s * root.glide-s * root.glide-s - 3 * root.glide-s * root.glide-s + 1)
                    + root.glide-move * 1px * (root.glide-s * root.glide-s * root.glide-s - 2 * root.glide-s * root.glide-s + root.glide-s)
                    + root.rest * (3 * root.glide-s * root.glide-s - 2 * root.glide-s * root.glide-s * root.glide-s)
                : swipe.swiping ? root.offset : root.rest;
            width: root.width;
            height: root.height;
            background: Palette.background;
            Rectangle {
                // Expanded, the open message is marked on the timeline instead.
                background: root.expanded ? Palette.foreground.with-alpha(0.03)
                    : root.selected ? Theme.selection
                    : touch.has-hover ? Palette.foreground.with-alpha(0.04) : transparent;
                animate background { duration: 120ms; easing: ease-out; }
            }
            HorizontalLayout {
                height: root.head;
                y: 0;
                padding: 10px;
                padding-left: 6px;
                spacing: 6px;
                Rectangle {
                    width: 18px;
                    if !root.selecting: Rectangle {
                        x: 5px;
                        y: 6px;
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: msg.seen ? transparent : Theme.unread-dot;
                    }
                    if root.selecting: Rectangle {
                        y: 2px;
                        width: 18px;
                        height: 18px;
                        border-radius: 9px;
                        border-width: 2px;
                        border-color: Theme.accent;
                        background: msg.checked ? Theme.accent : transparent;
                        if msg.checked: Path {
                            width: 12px;
                            height: 12px;
                            commands: "M 2 6 L 5 9 L 10 3";
                            stroke: white;
                            stroke-width: 2px;
                            fill: transparent;
                        }
                    }
                }
                VerticalLayout {
                    spacing: 2px;
                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: msg.sender;
                            font-weight: msg.seen ? 400 : 700;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        // Searching all folders: where each one is.
                        if msg.folder-label != "": Rectangle {
                            height: 16px;
                            width: folder-tag.preferred-width + 10px;
                            border-radius: 4px;
                            background: Palette.foreground.with-alpha(0.08);
                            accessible-role: text;
                            accessible-label: "in " + msg.folder-label;
                            folder-tag := Text {
                                text: msg.folder-label;
                                color: Theme.muted;
                                font-size: 11px;
                            }
                        }
                        if msg.count > 1: Text {
                            text: msg.count;
                            color: Theme.muted;
                            font-size: 12px;
                            accessible-label: msg.count + " messages";
                        }
                        if msg.answered: Image {
                            source: @image-url("icons/reply.svg");
                            colorize: Theme.muted;
                            width: 14px;
                            accessible-role: image;
                            accessible-label: "replied";
                        }
                        if msg.attachments: Image {
                            source: @image-url("icons/paperclip.svg");
                            colorize: Theme.muted;
                            width: 14px;
                            accessible-role: image;
                            accessible-label: "has attachments";
                        }
                        if msg.flagged: Image {
                            source: @image-url("icons/star.svg");
                            colorize: Theme.flag;
                            width: 14px;
                            accessible-role: image;
                            accessible-label: "flagged";
                        }
                        Text {
                            text: msg.date;
                            color: Theme.muted;
                            font-size: 12px;
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: msg.subject;
                            font-weight: msg.seen ? 400 : 600;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        // Several accounts in one list: whose mail it is.
                        if msg.account != "": Text {
                            text: msg.account;
                            color: root.line-color;
                            font-size: 11px;
                            vertical-alignment: center;
                            overflow: elide;
                            max-width: root.width / 3;
                            accessible-label: "account " + msg.account;
                        }
                    }
                    Text {
                        text: msg.snippet;
                        color: Theme.muted;
                        font-size: 12px;
                        overflow: elide;
                    }
                    if root.strip: HorizontalLayout {
                        height: 12px;
                        alignment: start;
                        spacing: 4px;
                        if msg.count > msg.dots.length: Text {
                            text: "+" + (msg.count - msg.dots.length);
                            color: Theme.muted;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                        HorizontalLayout {
                            // Hollow dots are read, filled ones unread, like the unfolded timeline.
                            for seen[k] in msg.dots: Rectangle {
                                width: k == 0 ? 8px : 22px;
                                if k > 0: Rectangle {
                                    x: 0;
                                    y: (parent.height - self.height) / 2;
                                    width: parent.width - 8px;
                                    height: 2px;
                                    background: root.line-color;
                                }
                                Rectangle {
                                    x: parent.width - 8px;
                                    y: (parent.height - self.height) / 2;
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    border-width: 2px;
                                    border-color: root.line-color;
                                    background: seen ? Palette.background : root.line-color;
                                }
                            }
                        }
                    }
                }
            }
            // Which account the message belongs to.
            Rectangle {
                x: 0;
                y: 0;
                width: 4px;
                height: parent.height;
                background: msg.color;
            }
            Divider {
                y: parent.height - 1px;
                height: 1px;
            }
            touch := TouchArea {
                y: 0;
                height: root.head;
                clicked => {
                    // A flick released within Slint's 100 ms gesture delay arrives as a click: still a swipe.
                    // Its press is replayed only at the release, so the duration is unknown; under 100 ms
                    // it was, which makes this the slowest speed it can have had.
                    let dx = self.mouse-x - self.pressed-x;
                    let dir = root.swipeable && abs(dx) > 8px ? root.decide(dx, dx / 1px / 100) : 0;
                    if dir != 0 {
                        root.act(dir);
                        root.glide(0, dx / 1px / 100);
                    // The release that ends a long press is not a click.
                    } else if !root.long-pressed {
                        root.clicked();
                    }
                }
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        root.long-pressed = false;
                    }
                }
            }
            Timer {
                interval: 500ms;
                running: touch.pressed && !root.long-pressed;
                triggered => {
                    root.long-pressed = true;
                    root.held();
                    root.check-toggled();
                }
            }
            // The left edge ticks the row, like an avatar in other mail apps.
            TouchArea {
                x: 0;
                y: 0;
                width: 30px;
                height: root.head;
                accessible-role: checkbox;
                accessible-label: "Select " + msg.sender + ": " + msg.subject;
                accessible-checked: msg.checked;
                accessible-action-default => { root.check-toggled(); }
                clicked => root.check-toggled();
            }
            if root.expanded: VerticalLayout {
                y: root.head;
                height: root.height - root.head;
                padding-left: 12px;
                padding-right: 8px;
                padding-bottom: 8px;
                for item[i] in root.thread: TimelineItem {
                    item: item;
                    current: i == root.thread-current;
                    first: i == 0;
                    last: i == root.thread.length - 1;
                    line-color: root.line-color;
                    clicked => root.thread-clicked(i);
                }
            }
        }
    }
}
