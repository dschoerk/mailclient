// Data passed between Rust and the UI.

export struct FolderItem {
    name: string,
    role: string,
    label: string,
    unread: int,
    depth: int,
    /// Account color; transparent with a single account.
    color: color,
}

export struct MessageItem {
    folder: string,
    uid: int,
    sender: string,
    subject: string,
    snippet: string,
    date: string,
    seen: bool,
    flagged: bool,
    answered: bool,
    attachments: bool,
    /// Account color; transparent with a single account.
    color: color,
    /// Messages in the conversation.
    count: int,
    /// Read state of the conversation's newest messages, oldest first; drawn as a mini timeline.
    dots: [bool],
    /// Ticked for an action on several conversations at once.
    checked: bool,
    /// Archived, deleted or moved a moment ago and still undoable: the row is a strip with Undo.
    /// "archive", "delete", "move" or "".
    removed: string,
    /// What happened, on the strip ("Archived", "Moved to Projects").
    removed-text: string,
    /// The message's folder, shown while the list spans all folders ("" otherwise).
    folder-label: string,
    /// The message's account, shown while the list holds several accounts' mail ("" otherwise).
    account: string,
}

export struct ConversationItem {
    sender: string,
    date: string,
    snippet: string,
    seen: bool,
}

/// One message of the conversation in the text reader (builds without Servo).
export struct ReaderPart {
    /// Sender and date; empty for a lone message.
    heading: string,
    text: string,
}

export struct AttachmentItem {
    index: int,
    name: string,
    size: string,
}

export struct SetupData {
    name: string,
    email: string,
    username: string,
    password: string,
    imap-host: string,
    imap-port: string,
    imap-starttls: bool,
    smtp-host: string,
    smtp-port: string,
    smtp-starttls: bool,
    /// Sign in with Microsoft in the browser instead of a password.
    oauth: bool,
    /// CalDAV server for password accounts; may be empty.
    caldav-url: string,
}

/// An account in Settings.
export struct AccountItem {
    name: string,
    email: string,
    color: color,
}

/// An event in a day of the month grid.
export struct CalendarChip {
    /// The event, for opening it.
    id: int,
    /// Start time on the day it starts; empty for all-day events and later days.
    time: string,
    title: string,
    color: color,
}

/// A cell of the month grid.
export struct CalendarDay {
    day: int,
    /// False for the days of the previous and next month that fill the grid.
    in-month: bool,
    today: bool,
    chips: [CalendarChip],
    /// Events that did not fit.
    more: int,
}

/// An event of the selected day.
export struct AgendaItem {
    id: int,
    time: string,
    title: string,
    location: string,
    /// Organizer, calendar and notes.
    detail: string,
    color: color,
}

/// The new event form.
export struct EventForm {
    title: string,
    /// YYYY-MM-DD
    date: string,
    /// HH:MM
    start: string,
    end: string,
    all-day: bool,
    location: string,
    notes: string,
}

/// Someone invited to the event in the form.
export struct AttendeeItem {
    name: string,
    email: string,
    /// "Accepted", "Tentative", "Declined", "No answer yet", or "Will be invited" (added in the form).
    status: string,
}

/// An event in the week or day view.
export struct EventBlock {
    id: int,
    title: string,
    time: string,
    color: color,
    /// Minutes after midnight, and minutes long.
    start: int,
    length: int,
    /// Overlapping events share the column: this one is lane `lane` of `lanes`.
    lane: int,
    lanes: int,
}

/// A day of the week or day view.
export struct DayColumn {
    label: string,
    today: bool,
    all-day: [EventBlock],
    blocks: [EventBlock],
}

/// The opened event.
export struct EventDetail {
    title: string,
    when: string,
    location: string,
    /// Calendar and account.
    calendar: string,
    /// "Name <address>"; empty when nobody organizes it.
    organizer: string,
    attendees: [AttendeeItem],
    notes: string,
    /// The user organizes it (or nobody does): it can be changed.
    can-edit: bool,
    /// An instance of a repeating event: changes apply to the series.
    recurring: bool,
}
