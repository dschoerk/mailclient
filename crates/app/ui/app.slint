import { Button, LineEdit, ListView, ScrollView, CheckBox, Palette, Spinner } from "std-widgets.slint";
import { Webview } from "../src/webview/webview.slint";
import { FolderItem, MessageItem, ConversationItem, AttachmentItem, ReaderPart, SetupData } from "types.slint";
import { Theme, Divider, ToolButton, FloatButton } from "widgets.slint";
import { FolderRow, MessageRow, TimelineItem } from "lists.slint";
import { SetupView } from "setup.slint";
import { ComposeView } from "compose.slint";

export { WebviewLogic } from "../src/webview/webview.slint";
export { FolderItem, MessageItem, ConversationItem, AttachmentItem, ReaderPart, SetupData } from "types.slint";

export component AppWindow inherits Window {
    title: "Mail";
    preferred-width: 1360px;
    preferred-height: 860px;
    min-width: 320px;
    min-height: 400px;

    // ---- state set from Rust ----
    in property <bool> needs-setup;
    in-out property <SetupData> setup;
    in property <string> setup-error;
    in property <bool> setup-busy;
    in property <bool> use-webview;
    in property <string> account-label;

    in property <[FolderItem]> folders;
    in property <int> current-folder: -1;
    in property <[MessageItem]> messages;
    in property <int> current-message: -1;
    in property <string> list-title;
    in property <bool> searching;

    in property <string> status;
    in property <bool> online: true;
    in property <bool> has-account;

    in property <bool> has-message;
    in property <string> msg-subject;
    in property <string> msg-from;
    in property <string> msg-to;
    in property <string> msg-cc;
    in property <string> msg-date;
    in property <bool> msg-flagged;
    /// The open message is in Drafts: it can be edited.
    in property <bool> msg-is-draft;
    in property <bool> msg-seen;
    in property <bool> msg-loading;
    in property <bool> msg-remote-blocked;
    in property <string> msg-text;
    in property <[AttachmentItem]> msg-attachments;
    // Every message of the open conversation, oldest first; empty for a lone message.
    in property <[ConversationItem]> conversation;
    in property <int> current-in-conversation: -1;
    // The text reader's messages, oldest first; the open one is current-in-conversation.
    in property <[ReaderPart]> msg-parts;
    // Phones: the reader's thumb actions sit on this side.
    in-out property <bool> left-handed;
    in-out property <bool> floating-buttons;

    // ---- user actions ----
    callback setup-email-edited(string);
    callback setup-submit();
    callback setup-cancel();
    callback add-account();
    callback folder-selected(int);
    callback message-selected(int);
    callback conversation-selected(int);
    callback search(string);
    callback refresh();
    callback compose();
    callback reply();
    callback reply-all();
    callback forward();
    callback edit-draft();
    callback archive();
    callback delete();
    callback toggle-seen();
    callback toggle-flag();
    callback load-remote-images();
    callback save-attachment(int);
    callback open-attachment(int);
    callback close-message();
    callback settings-changed();

    // ---- composing (inline; phones show it as its own page) ----
    in property <bool> composing;
    in-out property <string> compose-to;
    in-out property <string> compose-cc;
    in-out property <string> compose-bcc;
    in-out property <string> compose-subject;
    in-out property <string> compose-body;
    in property <[AttachmentItem]> compose-attachments;
    in property <bool> compose-sending;
    in property <string> compose-error;
    in property <[string]> compose-from-options;
    in-out property <int> compose-from-index;
    callback compose-send();
    callback compose-attach();
    callback compose-remove-attachment(int);
    callback compose-discard();
    callback compose-close();

    // Phones: one pane at a time (1 list, 2 message); folders are a drawer over them.
    property <bool> narrow: root.width < 700px;
    in-out property <bool> show-folders;
    property <int> pane: root.composing || root.has-message ? 2 : 1;

    // Always present, also under the setup screen: the webview must never be destroyed.
    keys := FocusScope {
        init => {
            self.focus();
        }
        property <bool> needs-setup: root.needs-setup;
        changed needs-setup => {
            if !self.needs-setup {
                self.focus();
            }
        }
        // The compose fields held focus; take it back so keys (and Android Back) still work.
        property <bool> composing: root.composing;
        changed composing => {
            if !self.composing {
                self.focus();
            }
        }
        function select-relative(delta: int) {
            if root.messages.length == 0 {
                return;
            }
            root.message-selected(max(0, min(root.messages.length - 1, root.current-message + delta)));
            // Keep the selection in view.
            let row-top = root.current-message * 74px;
            if row-top < -message-list.content-y {
                message-list.content-y = -row-top;
            } else if row-top + 74px > -message-list.content-y + message-list.visible-height {
                message-list.content-y = -(row-top + 74px - message-list.visible-height);
            }
        }

        key-pressed(event) => {
            if root.needs-setup || event.modifiers.control || event.modifiers.alt || event.modifiers.meta {
                return reject;
            }
            if event.text == "j" || event.text == Key.DownArrow {
                self.select-relative(1);
                return accept;
            }
            if event.text == "k" || event.text == Key.UpArrow {
                self.select-relative(-1);
                return accept;
            }
            if event.text == "c" {
                root.compose();
                return accept;
            }
            if event.text == "r" {
                root.reply();
                return accept;
            }
            if event.text == "a" {
                root.reply-all();
                return accept;
            }
            if event.text == "f" {
                root.forward();
                return accept;
            }
            if event.text == "e" {
                root.archive();
                return accept;
            }
            if event.text == "#" || event.text == Key.Delete {
                root.delete();
                return accept;
            }
            if event.text == "u" {
                root.toggle-seen();
                return accept;
            }
            if event.text == "s" {
                root.toggle-flag();
                return accept;
            }
            if event.text == "/" {
                search-box.focus();
                return accept;
            }
            // Android Back: leave the message or folder pane; unhandled at the top level, so Android closes the app.
            if event.text == Key.Back && (root.has-message || root.show-folders) {
                if root.has-message {
                    root.close-message();
                } else {
                    root.show-folders = false;
                }
                return accept;
            }
            if event.text == Key.Escape {
                search-box.text = "";
                root.search("");
                self.focus();
                return accept;
            }
            reject
        }

        VerticalLayout {
            // Fixed position: the panes size from the window, not the other way round.
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            padding-top: root.safe-area-insets.top;
            padding-bottom: root.safe-area-insets.bottom;
            padding-left: root.safe-area-insets.left;
            padding-right: root.safe-area-insets.right;
            HorizontalLayout {
                // ---- folders ----
                // Space for the sidebar, which is drawn over it below (a drawer on phones).
                Rectangle {
                    width: root.narrow ? 0px : 200px;
                }

                Divider {
                    width: root.narrow ? 0px : 1px;
                }

                // ---- message list ----
                Rectangle {
                        width: root.narrow ? (root.pane == 1 ? root.width : 0px) : 340px;
                    clip: true;
                    VerticalLayout {
                        HorizontalLayout {
                            padding: 10px;
                            spacing: 6px;
                            if root.narrow: ToolButton {
                                text: "Folders";
                                icon: @image-url("icons/menu.svg");
                                show-text: false;
                                clicked => {
                                    root.show-folders = true;
                                    // So Back closes the drawer instead of the app.
                                    keys.focus();
                                }
                            }
                            search-box := LineEdit {
                            accessible-label: "Search";
                                placeholder-text: "Search mail  ( / )";
                                edited(text) => root.search(text);
                                accepted => keys.focus();
                            }
                            ToolButton {
                                text: "Sync";
                                icon: @image-url("icons/refresh-cw.svg");
                                show-text: false;
                                clicked => root.refresh();
                            }
                        }
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-bottom: 6px;
                            Text {
                                text: root.list-title;
                                font-weight: 600;
                                font-size: 15px;
                                overflow: elide;
                            }
                        }
                        Divider {
                            height: 1px;
                        }
                        message-list := ListView {
                            for msg[i] in root.messages: MessageRow {
                                msg: msg;
                                selected: i == root.current-message;
                                thread: root.conversation;
                                thread-current: root.current-in-conversation;
                                clicked => {
                                    root.message-selected(i);
                                    keys.focus();
                                }
                                thread-clicked(j) => {
                                    root.conversation-selected(j);
                                    keys.focus();
                                }
                            }
                        }
                        if root.messages.length == 0: Rectangle {
                            vertical-stretch: 1;
                            Text {
                                text: root.searching ? "No matches in downloaded mail" : "No messages";
                                color: Theme.muted;
                            }
                        }
                    }
                }

                Divider {
                    width: root.narrow ? 0px : 1px;
                }

                // ---- reader ----
                Rectangle {
                        width: root.narrow ? (root.pane == 2 ? root.width : 0px) : root.width - 542px;
                    clip: true;
                    VerticalLayout {
                        if root.composing: ComposeView {
                            vertical-stretch: 1;
                            to <=> root.compose-to;
                            cc <=> root.compose-cc;
                            bcc <=> root.compose-bcc;
                            subject <=> root.compose-subject;
                            body <=> root.compose-body;
                            attachments: root.compose-attachments;
                            sending: root.compose-sending;
                            error: root.compose-error;
                            from-options: root.compose-from-options;
                            from-index <=> root.compose-from-index;
                            send => root.compose-send();
                            attach => root.compose-attach();
                            remove-attachment(i) => root.compose-remove-attachment(i);
                            discard => root.compose-discard();
                            close => root.compose-close();
                        }
                        if !root.has-message && !root.narrow && !root.composing: Rectangle {
                            vertical-stretch: 1;
                            Text {
                                text: "No message selected";
                                color: Theme.muted;
                            }
                        }
                        if root.has-message && !root.composing: VerticalLayout {
                            padding: 14px;
                            padding-bottom: 8px;
                            spacing: 6px;
                            HorizontalLayout {
                                spacing: 2px;
                                // Labels only when the reader is wide enough; icons alone on phones.
                                property <bool> labels: !root.narrow && root.width >= 1250px;
                                if root.narrow: ToolButton {
                                    text: "Back";
                                    icon: @image-url("icons/arrow-left.svg");
                                    show-text: false;
                                    clicked => root.close-message();
                                }
                                if root.msg-is-draft: ToolButton {
                                    text: "Edit draft";
                                    icon: @image-url("icons/file-pen-line.svg");
                                    show-text: true;
                                    clicked => root.edit-draft();
                                }
                                ToolButton {
                                    text: "Reply";
                                    icon: @image-url("icons/reply.svg");
                                    show-text: parent.labels;
                                    clicked => root.reply();
                                }
                                ToolButton {
                                    text: "Reply all";
                                    icon: @image-url("icons/reply-all.svg");
                                    show-text: parent.labels;
                                    clicked => root.reply-all();
                                }
                                ToolButton {
                                    text: "Forward";
                                    icon: @image-url("icons/forward.svg");
                                    show-text: parent.labels;
                                    clicked => root.forward();
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                }
                                ToolButton {
                                    text: root.msg-flagged ? "Unflag" : "Flag";
                                    icon: @image-url("icons/star.svg");
                                    show-text: false;
                                    icon-color: root.msg-flagged ? Theme.flag : Palette.foreground;
                                    clicked => root.toggle-flag();
                                }
                                ToolButton {
                                    text: root.msg-seen ? "Mark unread" : "Mark read";
                                    icon: root.msg-seen ? @image-url("icons/mail.svg") : @image-url("icons/mail-open.svg");
                                    show-text: false;
                                    clicked => root.toggle-seen();
                                }
                                // Phones have these in the thumb bar at the bottom.
                                if !root.narrow: ToolButton {
                                    text: "Archive";
                                    icon: @image-url("icons/archive.svg");
                                    show-text: parent.labels;
                                    clicked => root.archive();
                                }
                                if !root.narrow: ToolButton {
                                    text: "Delete";
                                    icon: @image-url("icons/trash.svg");
                                    show-text: parent.labels;
                                    clicked => root.delete();
                                }
                            }
                            Text {
                                text: root.msg-subject;
                                font-size: 19px;
                                font-weight: 600;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                Text {
                                    text: root.msg-from;
                                    font-weight: 600;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: root.msg-date;
                                    color: Theme.muted;
                                }
                            }
                            Text {
                                text: "To: " + root.msg-to + (root.msg-cc != "" ? "   Cc: " + root.msg-cc : "");
                                color: Theme.muted;
                                font-size: 12px;
                                overflow: elide;
                            }
                            // Phones hide the list, so the conversation's timeline moves into the reader.
                            if root.narrow && root.conversation.length > 1: ListView {
                                height: min(root.conversation.length, 4) * 30px;
                                vertical-stretch: 0;
                                // Keeps the open entry in view, with the one before it for context.
                                property <int> current: root.current-in-conversation;
                                function reveal() {
                                    self.viewport-y = -max(0, min(self.current - 1, root.conversation.length - 4)) * 30px;
                                }
                                init => { self.reveal(); }
                                changed current => { self.reveal(); }
                                for item[i] in root.conversation: TimelineItem {
                                    item: item;
                                    current: i == root.current-in-conversation;
                                    first: i == 0;
                                    last: i == root.conversation.length - 1;
                                    line-color: Theme.accent;
                                    clicked => root.conversation-selected(i);
                                }
                            }
                            if root.msg-attachments.length > 0: HorizontalLayout {
                                spacing: 6px;
                                for att in root.msg-attachments: Rectangle {
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: Theme.divider;
                                    height: 28px;
                                    min-width: att-chip.preferred-width;
                                    att-chip := HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 6px;
                                        Image {
                                            source: @image-url("icons/paperclip.svg");
                                            colorize: Theme.muted;
                                            width: 14px;
                                        }
                                        Text {
                                            text: att.name + "  " + att.size;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                        }
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => root.save-attachment(att.index);
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                }
                            }
                            if root.msg-remote-blocked: Rectangle {
                                height: 32px;
                                border-radius: 6px;
                                background: Palette.foreground.with-alpha(0.06);
                                HorizontalLayout {
                                    padding-left: 10px;
                                    spacing: 10px;
                                    Image {
                                        source: @image-url("icons/image.svg");
                                        colorize: Theme.muted;
                                        width: 16px;
                                    }
                                    Text {
                                        text: "Remote images are blocked to protect your privacy.";
                                        vertical-alignment: center;
                                        font-size: 12px;
                                    }
                                    ToolButton {
                                        text: "Load images";
                                        clicked => root.load-remote-images();
                                    }
                                    Rectangle {
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                        }
                        Divider {
                            height: 1px;
                            visible: root.has-message && !root.composing;
                        }
                        Rectangle {
                            vertical-stretch: root.has-message && !root.composing ? 1 : 0;
                            // The hidden webview's rendered page would otherwise claim its height and squash the composer.
                            preferred-height: 0px;
                            // The webview stays alive for the whole session; Servo
                            // renders into it, so it is only hidden, never destroyed.
                            if root.use-webview: Webview {
                                width: 100%;
                                height: 100%;
                                visible: root.has-message && !root.composing;
                            }
                            if !root.use-webview && root.has-message && !root.composing: reader-scroll := ScrollView {
                                VerticalLayout {
                                    width: reader-scroll.visible-width;
                                    padding: 14px;
                                    padding-top: 12px;
                                    spacing: 18px;
                                    for part[i] in root.msg-parts: part-row := HorizontalLayout {
                                        spacing: 8px;
                                        // Scrolls to the open message once laid out; Rust sets a new model on every
                                        // render, so this runs again for each opened message.
                                        Timer {
                                            interval: 1ms;
                                            running: i == root.current-in-conversation;
                                            triggered => {
                                                reader-scroll.viewport-y = -part-row.y;
                                                self.running = false;
                                            }
                                        }
                                        // Marks the open message, like the Servo reader.
                                        if root.msg-parts.length > 1: Rectangle {
                                            width: 3px;
                                            background: i == root.current-in-conversation ? Theme.accent : Theme.divider;
                                        }
                                        VerticalLayout {
                                            spacing: 8px;
                                            if part.heading != "": Text {
                                                text: part.heading;
                                                color: Theme.muted;
                                                font-size: 12px;
                                                wrap: word-wrap;
                                            }
                                            Text {
                                                text: part.text;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }
                                }
                            }
                            if root.msg-loading: Spinner {
                                indeterminate: true;
                                width: 32px;
                                height: 32px;
                            }
                            // Floating variant of the thumb bar: stacked in the thumb's corner, Next lowest.
                            if root.narrow && root.has-message && !root.composing && root.floating-buttons: VerticalLayout {
                                // Unsized children fill their parent; keep the column at its natural size.
                                width: self.preferred-width;
                                height: self.preferred-height;
                                x: root.left-handed ? 16px : parent.width - self.width - 16px;
                                y: parent.height - self.height - 16px;
                                spacing: 12px;
                                FloatButton {
                                    text: "Delete";
                                    icon: @image-url("icons/trash.svg");
                                    clicked => root.delete();
                                }
                                FloatButton {
                                    text: "Archive";
                                    icon: @image-url("icons/archive.svg");
                                    clicked => root.archive();
                                }
                                FloatButton {
                                    text: "Next";
                                    icon: @image-url("icons/arrow-down.svg");
                                    clicked => keys.select-relative(1);
                                }
                            }
                        }
                        // ---- thumb bar (phones) ----
                        // Mirrored by hand, with Next nearest the edge where the thumb rests.
                        if root.narrow && root.has-message && !root.composing && !root.floating-buttons: Divider {
                            height: 1px;
                        }
                        if root.narrow && root.has-message && !root.composing && !root.floating-buttons: HorizontalLayout {
                            padding: 6px;
                            spacing: 8px;
                            Rectangle {
                                horizontal-stretch: root.left-handed ? 0 : 1;
                            }
                            if root.left-handed: ToolButton {
                                text: "Next";
                                icon: @image-url("icons/arrow-down.svg");
                                height: 48px;
                                min-width: 56px;
                                clicked => keys.select-relative(1);
                            }
                            if !root.left-handed: ToolButton {
                                text: "Delete";
                                icon: @image-url("icons/trash.svg");
                                show-text: false;
                                height: 48px;
                                min-width: 56px;
                                clicked => root.delete();
                            }
                            ToolButton {
                                text: "Archive";
                                icon: @image-url("icons/archive.svg");
                                show-text: false;
                                height: 48px;
                                min-width: 56px;
                                clicked => root.archive();
                            }
                            if root.left-handed: ToolButton {
                                text: "Delete";
                                icon: @image-url("icons/trash.svg");
                                show-text: false;
                                height: 48px;
                                min-width: 56px;
                                clicked => root.delete();
                            }
                            if !root.left-handed: ToolButton {
                                text: "Next";
                                icon: @image-url("icons/arrow-down.svg");
                                height: 48px;
                                min-width: 56px;
                                clicked => keys.select-relative(1);
                            }
                            Rectangle {
                                horizontal-stretch: root.left-handed ? 1 : 0;
                            }
                        }
                    }
                }
            }

            // ---- status bar ----
            Divider {
                height: 1px;
            }
            HorizontalLayout {
                height: 24px;
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;
                Text {
                    text: root.status;
                    color: Theme.muted;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if root.has-account: Text {
                    text: root.online ? "● Online" : "○ Offline";
                    color: root.online ? #3a3 : Theme.muted;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }

            // Phones: tapping outside the drawer closes it.
            Rectangle {
                background: #0008;
                opacity: root.narrow && root.show-folders ? 1 : 0;
                animate opacity { duration: 200ms; }
                TouchArea {
                    enabled: root.narrow && root.show-folders;
                    clicked => { root.show-folders = false; }
                }
            }
            // ---- folders ----
            // Phones: a drawer covering 90% of the width, so the list stays visible behind it.
            Rectangle {
                width: root.narrow ? root.width * 0.9 : 200px;
                height: root.narrow ? root.height : root.height - root.safe-area-insets.top - root.safe-area-insets.bottom - 25px;
                x: root.narrow ? (root.show-folders ? 0px : -self.width) : root.safe-area-insets.left;
                y: root.narrow ? 0px : root.safe-area-insets.top;
                animate x { duration: 200ms; easing: ease-out; }
                clip: true;
                background: Theme.sidebar;
                VerticalLayout {
                    padding: 10px;
                    padding-top: 10px + (root.narrow ? root.safe-area-insets.top : 0px);
                    padding-bottom: 10px + (root.narrow ? root.safe-area-insets.bottom : 0px);
                    padding-left: 10px + (root.narrow ? root.safe-area-insets.left : 0px);
                    spacing: 8px;
                    Button {
                        text: "New message";
                        icon: @image-url("icons/square-pen.svg");
                        colorize-icon: true;
                        primary: true;
                        clicked => {
                            // Phones: after sending, return to the list, not the folder pane.
                            root.show-folders = false;
                            root.compose();
                        }
                    }
                    ListView {
                        for folder[i] in root.folders: FolderRow {
                            folder: folder;
                            selected: i == root.current-folder && !root.searching;
                            clicked => {
                                root.show-folders = false;
                                root.folder-selected(i);
                                keys.focus();
                            }
                        }
                    }
                    CheckBox {
                        text: "Left-handed";
                        checked <=> root.left-handed;
                        toggled => root.settings-changed();
                    }
                    CheckBox {
                        text: "Floating buttons";
                        checked <=> root.floating-buttons;
                        toggled => root.settings-changed();
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        Text {
                            text: root.account-label;
                            color: Theme.muted;
                            font-size: 12px;
                            overflow: elide;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        if root.has-account: ToolButton {
                            text: "Add account";
                            clicked => {
                                root.show-folders = false;
                                root.add-account();
                            }
                        }
                    }
                }
            }
    }

    if root.needs-setup: SetupView {
        data <=> root.setup;
        error: root.setup-error;
        busy: root.setup-busy;
        can-cancel: root.has-account;
        email-edited(t) => root.setup-email-edited(t);
        submit => root.setup-submit();
        cancel => root.setup-cancel();
    }
}
