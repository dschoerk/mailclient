import { Button, LineEdit, ListView, ScrollView, TextEdit, CheckBox, Palette, Spinner } from "std-widgets.slint";
import { Webview } from "../src/webview/webview.slint";

export { WebviewLogic } from "../src/webview/webview.slint";

export struct FolderItem {
    name: string,
    role: string,
    label: string,
    unread: int,
    depth: int,
}

export struct MessageItem {
    folder: string,
    uid: int,
    sender: string,
    subject: string,
    snippet: string,
    date: string,
    seen: bool,
    flagged: bool,
    answered: bool,
    attachments: bool,
}

export struct AttachmentItem {
    index: int,
    name: string,
    size: string,
}

export struct SetupData {
    name: string,
    email: string,
    username: string,
    password: string,
    imap-host: string,
    imap-port: string,
    imap-starttls: bool,
    smtp-host: string,
    smtp-port: string,
    smtp-starttls: bool,
}

global Theme {
    out property <brush> accent: #2f6fde;
    out property <brush> unread-dot: #2f6fde;
    out property <brush> flag: #e8a317;
    out property <brush> muted: Palette.foreground.with-alpha(0.6);
    out property <brush> divider: Palette.border;
    out property <brush> selection: Palette.selection-background;
    out property <brush> sidebar: Palette.alternate-background;
}

component Divider inherits Rectangle {
    background: Theme.divider;
}

/// Flat button with an icon (Lucide SVG) and an optional visible label. The label is
/// always the accessible name, so screen readers and tests see words, not pictures.
component ToolButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> show-text: true;
    in property <brush> icon-color: Palette.foreground;
    in property <bool> enabled: true;
    callback clicked();
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    height: 32px;
    min-width: content.preferred-width;
    border-radius: 6px;
    background: !root.enabled ? transparent : touch.pressed ? Palette.foreground.with-alpha(0.15) : touch.has-hover ? Palette.foreground.with-alpha(0.08) : transparent;
    content := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        alignment: center;
        if root.icon.width > 0: Image {
            source: root.icon;
            colorize: root.enabled ? root.icon-color : Theme.muted;
            width: 18px;
        }
        if root.show-text || root.icon.width == 0: Text {
            text: root.text;
            color: root.enabled ? Palette.foreground : Theme.muted;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => root.clicked();
    }
}

/// Round icon button that floats over content (phone reader actions).
component FloatButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    callback clicked();
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    width: 56px;
    height: 56px;
    border-radius: self.width / 2;
    background: touch.pressed ? Palette.alternate-background : Palette.background;
    border-width: 1px;
    border-color: Theme.divider;
    drop-shadow-blur: 8px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: #00000040;
    Image {
        source: root.icon;
        colorize: Palette.foreground;
        width: 22px;
    }
    touch := TouchArea {
        clicked => root.clicked();
    }
}

component FolderRow inherits Rectangle {
    in property <FolderItem> folder;
    in property <bool> selected;
    callback clicked();
    accessible-role: list-item;
    accessible-label: "Folder " + folder.label;
    accessible-action-default => { root.clicked(); }
    height: 30px;
    border-radius: 6px;
    background: selected ? Theme.selection : touch.has-hover ? Palette.foreground.with-alpha(0.05) : transparent;
    HorizontalLayout {
        padding-left: 10px + folder.depth * 14px;
        padding-right: 10px;
        spacing: 8px;
        Image {
            width: 16px;
            colorize: Theme.muted;
            source: folder.role == "inbox" ? @image-url("icons/inbox.svg")
                : folder.role == "sent" ? @image-url("icons/send.svg")
                : folder.role == "drafts" ? @image-url("icons/file-pen-line.svg")
                : folder.role == "trash" ? @image-url("icons/trash.svg")
                : folder.role == "junk" ? @image-url("icons/shield-alert.svg")
                : folder.role == "archive" ? @image-url("icons/archive.svg")
                : folder.role == "all" ? @image-url("icons/mails.svg")
                : folder.role == "flagged" ? @image-url("icons/star.svg")
                : @image-url("icons/folder.svg");
        }
        Text {
            text: folder.label;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            font-weight: folder.unread > 0 ? 600 : 400;
        }
        if folder.unread > 0: Text {
            text: folder.unread;
            vertical-alignment: center;
            color: Theme.muted;
            font-size: 12px;
        }
    }
    touch := TouchArea {
        clicked => root.clicked();
    }
}

component MessageRow inherits Rectangle {
    in property <MessageItem> msg;
    in property <bool> selected;
    callback clicked();
    accessible-role: list-item;
    accessible-label: msg.sender + ": " + msg.subject;
    accessible-action-default => { root.clicked(); }
    height: 74px;
    background: selected ? Theme.selection : touch.has-hover ? Palette.foreground.with-alpha(0.04) : transparent;
    HorizontalLayout {
        padding: 10px;
        padding-left: 6px;
        spacing: 6px;
        Rectangle {
            width: 10px;
            Rectangle {
                y: 6px;
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: msg.seen ? transparent : Theme.unread-dot;
            }
        }
        VerticalLayout {
            spacing: 2px;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: msg.sender;
                    font-weight: msg.seen ? 400 : 700;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if msg.answered: Image {
                    source: @image-url("icons/reply.svg");
                    colorize: Theme.muted;
                    width: 14px;
                    accessible-role: image;
                    accessible-label: "replied";
                }
                if msg.attachments: Image {
                    source: @image-url("icons/paperclip.svg");
                    colorize: Theme.muted;
                    width: 14px;
                    accessible-role: image;
                    accessible-label: "has attachments";
                }
                if msg.flagged: Image {
                    source: @image-url("icons/star.svg");
                    colorize: Theme.flag;
                    width: 14px;
                    accessible-role: image;
                    accessible-label: "flagged";
                }
                Text {
                    text: msg.date;
                    color: Theme.muted;
                    font-size: 12px;
                }
            }
            Text {
                text: msg.subject;
                font-weight: msg.seen ? 400 : 600;
                overflow: elide;
            }
            Text {
                text: msg.snippet;
                color: Theme.muted;
                font-size: 12px;
                overflow: elide;
            }
        }
    }
    Divider {
        y: parent.height - 1px;
        height: 1px;
    }
    touch := TouchArea {
        clicked => root.clicked();
    }
}

component Field inherits HorizontalLayout {
    in property <string> label;
    in-out property <string> text;
    in property <string> placeholder;
    in property <InputType> input-type: InputType.text;
    callback edited(string);
    spacing: 8px;
    Text {
        text: root.label;
        width: 90px;
        vertical-alignment: center;
        horizontal-alignment: right;
        color: Theme.muted;
    }
    LineEdit {
        accessible-label: root.label;
        text <=> root.text;
        placeholder-text: root.placeholder;
        input-type: root.input-type;
        edited(t) => root.edited(t);
    }
}

component SetupView inherits Rectangle {
    in-out property <SetupData> data;
    in property <string> error;
    in property <bool> busy;
    callback email-edited(string);
    callback submit();
    background: Palette.background;

    VerticalLayout {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: min(520px, root.width - 32px);
                spacing: 10px;
                Text {
                    text: "Set up your mail account";
                    font-size: 22px;
                    font-weight: 600;
                }
                Text {
                    text: "Use an app password for Gmail, iCloud and Fastmail. Outlook.com requires OAuth sign-in, which is not supported yet.";
                    color: Theme.muted;
                    wrap: word-wrap;
                }
                Field {
                    label: "Email";
                    text <=> data.email;
                    placeholder: "you@example.org";
                    edited(t) => root.email-edited(t);
                }
                Field {
                    label: "Your name";
                    text <=> data.name;
                }
                Field {
                    label: "Password";
                    text <=> data.password;
                    input-type: InputType.password;
                }
                Divider {
                    height: 1px;
                }
                Field {
                    label: "Username";
                    text <=> data.username;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Field {
                        label: "IMAP server";
                        text <=> data.imap-host;
                    }
                    LineEdit {
                        accessible-label: "IMAP port";
                        width: 56px;
                        text <=> data.imap-port;
                    }
                }
                // Own row: next to host and port it does not fit on phones.
                HorizontalLayout {
                    padding-left: 98px;
                    CheckBox {
                        text: "IMAP: STARTTLS instead of TLS";
                        checked <=> data.imap-starttls;
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Field {
                        label: "SMTP server";
                        text <=> data.smtp-host;
                    }
                    LineEdit {
                        accessible-label: "SMTP port";
                        width: 56px;
                        text <=> data.smtp-port;
                    }
                }
                // Own row: next to host and port it does not fit on phones.
                HorizontalLayout {
                    padding-left: 98px;
                    CheckBox {
                        text: "SMTP: STARTTLS instead of TLS";
                        checked <=> data.smtp-starttls;
                    }
                }
                if root.error != "": Text {
                    text: root.error;
                    color: #d33;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;
                    if root.busy: Spinner {
                        indeterminate: true;
                        width: 24px;
                        height: 24px;
                    }
                    Button {
                        text: "Save and connect";
                        primary: true;
                        enabled: !root.busy;
                        clicked => root.submit();
                    }
                }
            }
        }
    }
}

/// Compose form. Lives inside the main window (Android has a single window surface).
component ComposeView {

    in-out property <string> to;
    in-out property <string> cc;
    in-out property <string> bcc;
    in-out property <string> subject;
    in-out property <string> body;
    in property <[AttachmentItem]> attachments;
    in property <bool> sending;
    in property <string> error;

    callback send();
    callback attach();
    callback remove-attachment(int);
    callback discard();

    init => {
        if root.to == "" {
            to-edit.focus();
        } else {
            body-edit.focus();
        }
    }

    FocusScope {
        key-pressed(event) => {
            if event.modifiers.control && event.text == Key.Return {
                root.send();
                return accept;
            }
            // Android Back discards the draft rather than closing the app.
            if event.text == Key.Back && !root.sending {
                root.discard();
                return accept;
            }
            reject
        }
        VerticalLayout {
            padding: 12px;
            spacing: 8px;
            // Top bar: Discard where a back button usually is, actions on the right.
            HorizontalLayout {
                spacing: 8px;
                ToolButton {
                    text: "Discard";
                    icon: @image-url("icons/x.svg");
                    show-text: false;
                    enabled: !root.sending;
                    clicked => root.discard();
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                if root.sending: Spinner {
                    indeterminate: true;
                    width: 24px;
                    height: 24px;
                }
                ToolButton {
                    text: "Attach…";
                    icon: @image-url("icons/paperclip.svg");
                    show-text: false;
                    enabled: !root.sending;
                    clicked => root.attach();
                }
                Button {
                    // Ctrl+Enter also sends.
                    text: "Send";
                    icon: @image-url("icons/send.svg");
                    colorize-icon: true;
                    primary: true;
                    enabled: !root.sending;
                    clicked => root.send();
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "To";
                    width: 60px;
                    vertical-alignment: center;
                    color: Theme.muted;
                }
                to-edit := LineEdit {
                    accessible-label: "To";
                    text <=> root.to;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Cc";
                    width: 60px;
                    vertical-alignment: center;
                    color: Theme.muted;
                }
                LineEdit {
                    accessible-label: "Cc";
                    text <=> root.cc;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Bcc";
                    width: 60px;
                    vertical-alignment: center;
                    color: Theme.muted;
                }
                LineEdit {
                    accessible-label: "Bcc";
                    text <=> root.bcc;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Subject";
                    width: 60px;
                    vertical-alignment: center;
                    color: Theme.muted;
                }
                LineEdit {
                    accessible-label: "Subject";
                    text <=> root.subject;
                }
            }
            body-edit := TextEdit {
                accessible-label: "Body";
                text <=> root.body;
                wrap: word-wrap;
                vertical-stretch: 1;
            }
            if root.attachments.length > 0: HorizontalLayout {
                spacing: 6px;
                for att[i] in root.attachments: Rectangle {
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Theme.divider;
                    height: 28px;
                    min-width: chip.preferred-width;
                    chip := HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;
                        Image {
                            source: @image-url("icons/paperclip.svg");
                            colorize: Theme.muted;
                            width: 14px;
                        }
                        Text {
                            text: att.name + "  " + att.size;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        Image {
                            source: @image-url("icons/x.svg");
                            colorize: Theme.muted;
                            width: 14px;
                        }
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => root.remove-attachment(i);
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            if root.error != "": Text {
                text: root.error;
                color: #d33;
                wrap: word-wrap;
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Mail";
    preferred-width: 1360px;
    preferred-height: 860px;
    min-width: 320px;
    min-height: 400px;

    // ---- state set from Rust ----
    in property <bool> needs-setup;
    in-out property <SetupData> setup;
    in property <string> setup-error;
    in property <bool> setup-busy;
    in property <bool> use-webview;
    in property <string> account-label;

    in property <[FolderItem]> folders;
    in property <int> current-folder: -1;
    in property <[MessageItem]> messages;
    in property <int> current-message: -1;
    in property <string> list-title;
    in property <bool> searching;

    in property <string> status;
    in property <bool> online: true;
    in property <bool> has-account;

    in property <bool> has-message;
    in property <string> msg-subject;
    in property <string> msg-from;
    in property <string> msg-to;
    in property <string> msg-cc;
    in property <string> msg-date;
    in property <bool> msg-flagged;
    in property <bool> msg-seen;
    in property <bool> msg-loading;
    in property <bool> msg-remote-blocked;
    in property <string> msg-text;
    in property <[AttachmentItem]> msg-attachments;
    // Phones: the reader's thumb actions sit on this side.
    in-out property <bool> left-handed;
    in-out property <bool> floating-buttons;

    // ---- user actions ----
    callback setup-email-edited(string);
    callback setup-submit();
    callback folder-selected(int);
    callback message-selected(int);
    callback search(string);
    callback refresh();
    callback compose();
    callback reply();
    callback reply-all();
    callback forward();
    callback archive();
    callback delete();
    callback toggle-seen();
    callback toggle-flag();
    callback load-remote-images();
    callback save-attachment(int);
    callback open-attachment(int);
    callback close-message();
    callback settings-changed();

    // ---- composing (inline; phones show it as its own page) ----
    in property <bool> composing;
    in-out property <string> compose-to;
    in-out property <string> compose-cc;
    in-out property <string> compose-bcc;
    in-out property <string> compose-subject;
    in-out property <string> compose-body;
    in property <[AttachmentItem]> compose-attachments;
    in property <bool> compose-sending;
    in property <string> compose-error;
    callback compose-send();
    callback compose-attach();
    callback compose-remove-attachment(int);
    callback compose-discard();

    // Phones: one pane at a time (1 list, 2 message); folders are a drawer over them.
    property <bool> narrow: root.width < 700px;
    in-out property <bool> show-folders;
    property <int> pane: root.composing || root.has-message ? 2 : 1;

    if root.needs-setup: SetupView {
        data <=> root.setup;
        error: root.setup-error;
        busy: root.setup-busy;
        email-edited(t) => root.setup-email-edited(t);
        submit => root.setup-submit();
    }

    if !root.needs-setup: keys := FocusScope {
        init => {
            self.focus();
        }
        // The compose fields held focus; take it back so keys (and Android Back) still work.
        property <bool> composing: root.composing;
        changed composing => {
            if !self.composing {
                self.focus();
            }
        }
        function select-relative(delta: int) {
            if root.messages.length == 0 {
                return;
            }
            root.message-selected(max(0, min(root.messages.length - 1, root.current-message + delta)));
            // Keep the selection in view.
            let row-top = root.current-message * 74px;
            if row-top < -message-list.content-y {
                message-list.content-y = -row-top;
            } else if row-top + 74px > -message-list.content-y + message-list.visible-height {
                message-list.content-y = -(row-top + 74px - message-list.visible-height);
            }
        }

        key-pressed(event) => {
            if event.modifiers.control || event.modifiers.alt || event.modifiers.meta {
                return reject;
            }
            if event.text == "j" || event.text == Key.DownArrow {
                self.select-relative(1);
                return accept;
            }
            if event.text == "k" || event.text == Key.UpArrow {
                self.select-relative(-1);
                return accept;
            }
            if event.text == "c" {
                root.compose();
                return accept;
            }
            if event.text == "r" {
                root.reply();
                return accept;
            }
            if event.text == "a" {
                root.reply-all();
                return accept;
            }
            if event.text == "f" {
                root.forward();
                return accept;
            }
            if event.text == "e" {
                root.archive();
                return accept;
            }
            if event.text == "#" || event.text == Key.Delete {
                root.delete();
                return accept;
            }
            if event.text == "u" {
                root.toggle-seen();
                return accept;
            }
            if event.text == "s" {
                root.toggle-flag();
                return accept;
            }
            if event.text == "/" {
                search-box.focus();
                return accept;
            }
            // Android Back: leave the message or folder pane; unhandled at the top level, so Android closes the app.
            if event.text == Key.Back && (root.has-message || root.show-folders) {
                if root.has-message {
                    root.close-message();
                } else {
                    root.show-folders = false;
                }
                return accept;
            }
            if event.text == Key.Escape {
                search-box.text = "";
                root.search("");
                self.focus();
                return accept;
            }
            reject
        }

        VerticalLayout {
            // Fixed position: the panes size from the window, not the other way round.
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            padding-top: root.safe-area-insets.top;
            padding-bottom: root.safe-area-insets.bottom;
            padding-left: root.safe-area-insets.left;
            padding-right: root.safe-area-insets.right;
            HorizontalLayout {
                // ---- folders ----
                // Space for the sidebar, which is drawn over it below (a drawer on phones).
                Rectangle {
                    width: root.narrow ? 0px : 200px;
                }

                Divider {
                    width: root.narrow ? 0px : 1px;
                }

                // ---- message list ----
                Rectangle {
                        width: root.narrow ? (root.pane == 1 ? root.width : 0px) : 340px;
                    clip: true;
                    VerticalLayout {
                        HorizontalLayout {
                            padding: 10px;
                            spacing: 6px;
                            if root.narrow: ToolButton {
                                text: "Folders";
                                icon: @image-url("icons/menu.svg");
                                show-text: false;
                                clicked => {
                                    root.show-folders = true;
                                    // So Back closes the drawer instead of the app.
                                    keys.focus();
                                }
                            }
                            search-box := LineEdit {
                            accessible-label: "Search";
                                placeholder-text: "Search mail  ( / )";
                                edited(text) => root.search(text);
                                accepted => keys.focus();
                            }
                            ToolButton {
                                text: "Sync";
                                icon: @image-url("icons/refresh-cw.svg");
                                show-text: false;
                                clicked => root.refresh();
                            }
                        }
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-bottom: 6px;
                            Text {
                                text: root.list-title;
                                font-weight: 600;
                                font-size: 15px;
                                overflow: elide;
                            }
                        }
                        Divider {
                            height: 1px;
                        }
                        message-list := ListView {
                            for msg[i] in root.messages: MessageRow {
                                msg: msg;
                                selected: i == root.current-message;
                                clicked => {
                                    root.message-selected(i);
                                    keys.focus();
                                }
                            }
                        }
                        if root.messages.length == 0: Rectangle {
                            vertical-stretch: 1;
                            Text {
                                text: root.searching ? "No matches in downloaded mail" : "No messages";
                                color: Theme.muted;
                            }
                        }
                    }
                }

                Divider {
                    width: root.narrow ? 0px : 1px;
                }

                // ---- reader ----
                Rectangle {
                        width: root.narrow ? (root.pane == 2 ? root.width : 0px) : root.width - 542px;
                    clip: true;
                    VerticalLayout {
                        if root.composing: ComposeView {
                            vertical-stretch: 1;
                            to <=> root.compose-to;
                            cc <=> root.compose-cc;
                            bcc <=> root.compose-bcc;
                            subject <=> root.compose-subject;
                            body <=> root.compose-body;
                            attachments: root.compose-attachments;
                            sending: root.compose-sending;
                            error: root.compose-error;
                            send => root.compose-send();
                            attach => root.compose-attach();
                            remove-attachment(i) => root.compose-remove-attachment(i);
                            discard => root.compose-discard();
                        }
                        if !root.has-message && !root.narrow && !root.composing: Rectangle {
                            vertical-stretch: 1;
                            Text {
                                text: "No message selected";
                                color: Theme.muted;
                            }
                        }
                        if root.has-message && !root.composing: VerticalLayout {
                            padding: 14px;
                            padding-bottom: 8px;
                            spacing: 6px;
                            HorizontalLayout {
                                spacing: 2px;
                                // Labels only when the reader is wide enough; icons alone on phones.
                                property <bool> labels: !root.narrow && root.width >= 1250px;
                                if root.narrow: ToolButton {
                                    text: "Back";
                                    icon: @image-url("icons/arrow-left.svg");
                                    show-text: false;
                                    clicked => root.close-message();
                                }
                                ToolButton {
                                    text: "Reply";
                                    icon: @image-url("icons/reply.svg");
                                    show-text: parent.labels;
                                    clicked => root.reply();
                                }
                                ToolButton {
                                    text: "Reply all";
                                    icon: @image-url("icons/reply-all.svg");
                                    show-text: parent.labels;
                                    clicked => root.reply-all();
                                }
                                ToolButton {
                                    text: "Forward";
                                    icon: @image-url("icons/forward.svg");
                                    show-text: parent.labels;
                                    clicked => root.forward();
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                }
                                ToolButton {
                                    text: root.msg-flagged ? "Unflag" : "Flag";
                                    icon: @image-url("icons/star.svg");
                                    show-text: false;
                                    icon-color: root.msg-flagged ? Theme.flag : Palette.foreground;
                                    clicked => root.toggle-flag();
                                }
                                ToolButton {
                                    text: root.msg-seen ? "Mark unread" : "Mark read";
                                    icon: root.msg-seen ? @image-url("icons/mail.svg") : @image-url("icons/mail-open.svg");
                                    show-text: false;
                                    clicked => root.toggle-seen();
                                }
                                // Phones have these in the thumb bar at the bottom.
                                if !root.narrow: ToolButton {
                                    text: "Archive";
                                    icon: @image-url("icons/archive.svg");
                                    show-text: parent.labels;
                                    clicked => root.archive();
                                }
                                if !root.narrow: ToolButton {
                                    text: "Delete";
                                    icon: @image-url("icons/trash.svg");
                                    show-text: parent.labels;
                                    clicked => root.delete();
                                }
                            }
                            Text {
                                text: root.msg-subject;
                                font-size: 19px;
                                font-weight: 600;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                Text {
                                    text: root.msg-from;
                                    font-weight: 600;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: root.msg-date;
                                    color: Theme.muted;
                                }
                            }
                            Text {
                                text: "To: " + root.msg-to + (root.msg-cc != "" ? "   Cc: " + root.msg-cc : "");
                                color: Theme.muted;
                                font-size: 12px;
                                overflow: elide;
                            }
                            if root.msg-attachments.length > 0: HorizontalLayout {
                                spacing: 6px;
                                for att in root.msg-attachments: Rectangle {
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: Theme.divider;
                                    height: 28px;
                                    min-width: att-chip.preferred-width;
                                    att-chip := HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 6px;
                                        Image {
                                            source: @image-url("icons/paperclip.svg");
                                            colorize: Theme.muted;
                                            width: 14px;
                                        }
                                        Text {
                                            text: att.name + "  " + att.size;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                        }
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => root.save-attachment(att.index);
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                }
                            }
                            if root.msg-remote-blocked: Rectangle {
                                height: 32px;
                                border-radius: 6px;
                                background: Palette.foreground.with-alpha(0.06);
                                HorizontalLayout {
                                    padding-left: 10px;
                                    spacing: 10px;
                                    Image {
                                        source: @image-url("icons/image.svg");
                                        colorize: Theme.muted;
                                        width: 16px;
                                    }
                                    Text {
                                        text: "Remote images are blocked to protect your privacy.";
                                        vertical-alignment: center;
                                        font-size: 12px;
                                    }
                                    ToolButton {
                                        text: "Load images";
                                        clicked => root.load-remote-images();
                                    }
                                    Rectangle {
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                        }
                        Divider {
                            height: 1px;
                            visible: root.has-message && !root.composing;
                        }
                        Rectangle {
                            vertical-stretch: root.has-message && !root.composing ? 1 : 0;
                            // The webview stays alive for the whole session; Servo
                            // renders into it, so it is only hidden, never destroyed.
                            if root.use-webview: Webview {
                                width: 100%;
                                height: 100%;
                                visible: root.has-message && !root.composing;
                            }
                            if !root.use-webview && root.has-message && !root.composing: ScrollView {
                                Text {
                                    x: 14px;
                                    y: 12px;
                                    width: parent.width - 28px;
                                    text: root.msg-text;
                                    wrap: word-wrap;
                                }
                            }
                            if root.msg-loading: Spinner {
                                indeterminate: true;
                                width: 32px;
                                height: 32px;
                            }
                            // Floating variant of the thumb bar: stacked in the thumb's corner, Next lowest.
                            if root.narrow && root.has-message && !root.composing && root.floating-buttons: VerticalLayout {
                                // Unsized children fill their parent; keep the column at its natural size.
                                width: self.preferred-width;
                                height: self.preferred-height;
                                x: root.left-handed ? 16px : parent.width - self.width - 16px;
                                y: parent.height - self.height - 16px;
                                spacing: 12px;
                                FloatButton {
                                    text: "Delete";
                                    icon: @image-url("icons/trash.svg");
                                    clicked => root.delete();
                                }
                                FloatButton {
                                    text: "Archive";
                                    icon: @image-url("icons/archive.svg");
                                    clicked => root.archive();
                                }
                                FloatButton {
                                    text: "Next";
                                    icon: @image-url("icons/arrow-down.svg");
                                    clicked => keys.select-relative(1);
                                }
                            }
                        }
                        // ---- thumb bar (phones) ----
                        // Mirrored by hand, with Next nearest the edge where the thumb rests.
                        if root.narrow && root.has-message && !root.composing && !root.floating-buttons: Divider {
                            height: 1px;
                        }
                        if root.narrow && root.has-message && !root.composing && !root.floating-buttons: HorizontalLayout {
                            padding: 6px;
                            spacing: 8px;
                            Rectangle {
                                horizontal-stretch: root.left-handed ? 0 : 1;
                            }
                            if root.left-handed: ToolButton {
                                text: "Next";
                                icon: @image-url("icons/arrow-down.svg");
                                height: 48px;
                                min-width: 56px;
                                clicked => keys.select-relative(1);
                            }
                            if !root.left-handed: ToolButton {
                                text: "Delete";
                                icon: @image-url("icons/trash.svg");
                                show-text: false;
                                height: 48px;
                                min-width: 56px;
                                clicked => root.delete();
                            }
                            ToolButton {
                                text: "Archive";
                                icon: @image-url("icons/archive.svg");
                                show-text: false;
                                height: 48px;
                                min-width: 56px;
                                clicked => root.archive();
                            }
                            if root.left-handed: ToolButton {
                                text: "Delete";
                                icon: @image-url("icons/trash.svg");
                                show-text: false;
                                height: 48px;
                                min-width: 56px;
                                clicked => root.delete();
                            }
                            if !root.left-handed: ToolButton {
                                text: "Next";
                                icon: @image-url("icons/arrow-down.svg");
                                height: 48px;
                                min-width: 56px;
                                clicked => keys.select-relative(1);
                            }
                            Rectangle {
                                horizontal-stretch: root.left-handed ? 1 : 0;
                            }
                        }
                    }
                }
            }

            // ---- status bar ----
            Divider {
                height: 1px;
            }
            HorizontalLayout {
                height: 24px;
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;
                Text {
                    text: root.status;
                    color: Theme.muted;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if root.has-account: Text {
                    text: root.online ? "● Online" : "○ Offline";
                    color: root.online ? #3a3 : Theme.muted;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }

            // Phones: tapping outside the drawer closes it.
            Rectangle {
                background: #0008;
                opacity: root.narrow && root.show-folders ? 1 : 0;
                animate opacity { duration: 200ms; }
                TouchArea {
                    enabled: root.narrow && root.show-folders;
                    clicked => { root.show-folders = false; }
                }
            }
            // ---- folders ----
            // Phones: a drawer covering 90% of the width, so the list stays visible behind it.
            Rectangle {
                width: root.narrow ? root.width * 0.9 : 200px;
                height: root.narrow ? root.height : root.height - root.safe-area-insets.top - root.safe-area-insets.bottom - 25px;
                x: root.narrow ? (root.show-folders ? 0px : -self.width) : root.safe-area-insets.left;
                y: root.narrow ? 0px : root.safe-area-insets.top;
                animate x { duration: 200ms; easing: ease-out; }
                clip: true;
                background: Theme.sidebar;
                VerticalLayout {
                    padding: 10px;
                    padding-top: 10px + (root.narrow ? root.safe-area-insets.top : 0px);
                    padding-bottom: 10px + (root.narrow ? root.safe-area-insets.bottom : 0px);
                    padding-left: 10px + (root.narrow ? root.safe-area-insets.left : 0px);
                    spacing: 8px;
                    Button {
                        text: "New message";
                        icon: @image-url("icons/square-pen.svg");
                        colorize-icon: true;
                        primary: true;
                        clicked => {
                            // Phones: after sending, return to the list, not the folder pane.
                            root.show-folders = false;
                            root.compose();
                        }
                    }
                    ListView {
                        for folder[i] in root.folders: FolderRow {
                            folder: folder;
                            selected: i == root.current-folder && !root.searching;
                            clicked => {
                                root.show-folders = false;
                                root.folder-selected(i);
                                keys.focus();
                            }
                        }
                    }
                    CheckBox {
                        text: "Left-handed";
                        checked <=> root.left-handed;
                        toggled => root.settings-changed();
                    }
                    CheckBox {
                        text: "Floating buttons";
                        checked <=> root.floating-buttons;
                        toggled => root.settings-changed();
                    }
                    Text {
                        text: root.account-label;
                        color: Theme.muted;
                        font-size: 12px;
                        overflow: elide;
                    }
                }
            }
    }
}

