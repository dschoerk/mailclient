import { Button, LineEdit, ListView, ScrollView, CheckBox, Palette, Spinner, TextEdit } from "std-widgets.slint";
import { Webview } from "../src/webview/webview.slint";
import { FolderItem, MessageItem, ConversationItem, AttachmentItem, ReaderPart, SetupData, AccountItem, CalendarDay, AgendaItem, EventForm, DayColumn, EventDetail, AttendeeItem } from "types.slint";
import { Theme, Divider, ToolButton, FloatButton, TextField } from "widgets.slint";
import { FolderRow, MessageRow, TimelineItem } from "lists.slint";
import { SetupView } from "setup.slint";
import { SettingsView } from "settings.slint";
import { ComposeView } from "compose.slint";
import { CalendarView } from "calendar.slint";

export { WebviewLogic } from "../src/webview/webview.slint";
export { Theme } from "widgets.slint";
export { FolderItem, MessageItem, ConversationItem, AttachmentItem, ReaderPart, SetupData, AccountItem, CalendarChip, CalendarDay, AgendaItem, EventForm, EventBlock, DayColumn, EventDetail, AttendeeItem } from "types.slint";

export component AppWindow inherits Window {
    title: "Mail";
    preferred-width: 1360px;
    preferred-height: 860px;
    min-width: 320px;
    min-height: 400px;

    // ---- state set from Rust ----
    in property <bool> needs-setup;
    in-out property <SetupData> setup;
    in property <string> setup-error;
    in property <bool> setup-busy;
    /// The setup form edits an existing account.
    in property <bool> setup-editing;
    in-out property <bool> show-settings;
    in property <[AccountItem]> accounts;
    in property <bool> use-webview;
    /// Android: a native WebView is laid over the reader area (html-x … html-visible).
    in property <bool> html-overlay;
    callback html-area-changed();
    out property <length> html-x: html-area.absolute-position.x;
    out property <length> html-y: html-area.absolute-position.y;
    out property <length> html-width: html-area.width;
    out property <length> html-height: html-area.height;
    // Anything drawn over the reader (drawer, setup) must hide the native view, which is always on top.
    out property <bool> html-visible: root.html-overlay && root.has-message && !root.composing && !root.needs-setup
        && !root.show-settings && !root.show-calendar && !root.source-open && !(root.narrow && root.show-folders);
    changed html-x => { root.html-area-changed(); }
    changed html-y => { root.html-area-changed(); }
    changed html-width => { root.html-area-changed(); }
    changed html-height => { root.html-area-changed(); }
    changed html-visible => { root.html-area-changed(); }
    property <bool> floating: root.floating-buttons;
    /// The floating buttons would sit under the native HTML view: it draws its own then (0 none, 1 right, 2 left).
    out property <int> html-buttons: root.html-visible && root.narrow && root.floating ? (root.left-handed ? 2 : 1) : 0;
    out property <color> float-background: Palette.background;
    out property <color> float-pressed: Palette.alternate-background;
    out property <color> float-foreground: Palette.foreground;
    out property <color> float-border: Theme.divider;
    changed html-buttons => { root.html-area-changed(); }
    /// Next from the native floating buttons.
    public function next-message() { keys.select-relative(1); }
    in property <string> account-label;

    in property <[FolderItem]> folders;
    in property <int> current-folder: -1;
    in property <[MessageItem]> messages;
    in property <int> current-message: -1;
    in property <string> list-title;
    in property <bool> searching;

    in property <string> status;
    /// What the last move or delete did, while it can still be undone ("" hides Undo).
    in property <string> undo-text;
    callback undo();
    /// Build number, date and profile, shown in the status bar.
    in property <string> version;
    /// A sync the user asked for is running.
    in property <bool> syncing;
    in property <bool> online: true;
    in property <bool> has-account;

    in property <bool> has-message;
    in property <string> msg-subject;
    in property <string> msg-from;
    in property <string> msg-to;
    in property <string> msg-cc;
    in property <string> msg-date;
    in property <bool> msg-flagged;
    /// The open message is in Drafts: it can be edited.
    in property <bool> msg-is-draft;
    in property <bool> msg-seen;
    in property <bool> msg-loading;
    in property <bool> msg-remote-blocked;
    in property <string> msg-text;
    /// The open message's raw source, shown in place of the body while source-open.
    in property <string> msg-source;
    in-out property <bool> source-open;
    in property <[AttachmentItem]> msg-attachments;
    // Every message of the open conversation, oldest first; empty for a lone message.
    in property <[ConversationItem]> conversation;
    in property <int> current-in-conversation: -1;
    /// The reader was scrolled by the user since the conversation was rendered; Rust resets it.
    in-out property <bool> reader-scrolled;
    /// The message at the top of the scrolled reader, or -1 until the user scrolls.
    in-out property <int> scrolled-in-conversation: -1;
    /// Highlighted on the conversation's timeline: follows the reader's scroll position.
    property <int> highlighted-in-conversation: root.reader-scrolled && root.scrolled-in-conversation >= 0 ? root.scrolled-in-conversation : root.current-in-conversation;
    // The text reader's messages, oldest first; the open one is current-in-conversation.
    in property <[ReaderPart]> msg-parts;
    // Phones: the reader's thumb actions sit on this side.
    in-out property <bool> left-handed;
    in-out property <bool> floating-buttons;
    /// 0 follows the system, 1 light, 2 dark.
    in-out property <int> theme;
    in-out property <bool> notifications: true;
    in-out property <bool> always-load-images;
    in-out property <bool> show-link-targets;
    changed theme => { root.apply-theme(); }
    init => { root.apply-theme(); }
    function apply-theme() {
        Palette.color-scheme = root.theme == 1 ? ColorScheme.light : root.theme == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }

    // ---- user actions ----
    callback setup-email-edited(string);
    callback setup-submit();
    callback setup-cancel();
    callback add-account();
    callback edit-account(int);
    callback remove-account(int);
    callback folder-selected(int);
    callback message-selected(int);
    callback conversation-selected(int);
    callback search(string);
    /// The message list was scrolled near its end.
    callback load-older();
    /// The search box's text, also set from Rust ("More from this sender").
    in-out property <string> search-text;
    /// Searches for all mail from the open message's sender.
    callback show-sender();
    callback refresh();
    callback compose();
    callback reply();
    callback reply-all();
    callback forward();
    callback edit-draft();
    /// Ticks or unticks a list row.
    callback toggle-checked(int);
    /// A list row was long-pressed: haptic feedback on phones.
    callback row-held();
    /// "seen", "flag", "archive", "delete" or "clear", on the ticked rows.
    callback bulk-action(string);
    /// A list row swiped away (phones): archived if true, else deleted.
    callback row-swiped(int, bool);
    in property <int> checked-count;
    in property <bool> checked-all-seen;
    in property <bool> checked-all-flagged;
    callback archive();
    callback delete();
    callback toggle-seen();
    callback toggle-flag();
    callback load-remote-images();
    callback save-attachment(int);
    callback open-attachment(int);
    callback close-message();
    /// Shows or hides the open message's source.
    callback view-source();
    callback save-eml();
    callback save-pdf();
    callback print();
    /// The reader's row of message tools (source, .eml, PDF, print) is open.
    in-out property <bool> tools-open;
    callback settings-changed();

    // ---- calendar ----
    in-out property <bool> show-calendar;
    /// 0 month, 1 week, 2 day.
    in-out property <int> calendar-view;
    in property <string> calendar-period-label;
    in property <[CalendarDay]> calendar-days;
    in property <[DayColumn]> calendar-columns;
    in property <int> calendar-selected;
    in property <string> calendar-day-label;
    in property <[AgendaItem]> calendar-agenda;
    in-out property <bool> calendar-editing;
    in-out property <bool> calendar-showing-event;
    in property <EventDetail> event-detail;
    in-out property <bool> calendar-confirm-delete;
    in-out property <EventForm> event-form;
    in property <bool> event-form-existing;
    in property <[string]> event-from-options;
    in-out property <int> event-from-index;
    in property <string> event-error;
    /// Calendar sync or save failures, shown on the calendar page until they clear.
    in property <string> calendar-error;
    /// The event form's attendees.
    in property <[AttendeeItem]> event-attendees;
    callback calendar-add-attendee(string) -> bool;
    callback calendar-remove-attendee(int);
    callback open-calendar();
    callback calendar-set-view(int);
    callback calendar-shift(int);
    callback calendar-today();
    callback calendar-day-clicked(int);
    callback calendar-event-clicked(int);
    callback calendar-edit-event();
    callback calendar-delete-event();
    callback calendar-new-event();
    callback calendar-save-event();
    callback calendar-refresh();
    /// The open message's invitation: REQUEST, REPLY, CANCEL or PUBLISH; empty without one.
    in property <string> invite-kind;
    in property <string> invite-title;
    in property <string> invite-when;
    in property <string> invite-where;
    in property <string> invite-detail;
    /// ACCEPTED, TENTATIVE, DECLINED, ADD (a plain event file) or REMOVE (a cancellation).
    callback invite-respond(string);

    // ---- composing (inline; phones show it as its own page) ----
    in property <bool> composing;
    in-out property <string> compose-to;
    in-out property <string> compose-cc;
    in-out property <string> compose-bcc;
    in-out property <string> compose-subject;
    in-out property <string> compose-body;
    in property <[AttachmentItem]> compose-attachments;
    in property <bool> compose-sending;
    in property <string> compose-error;
    in property <[string]> compose-from-options;
    in-out property <int> compose-from-index;
    callback compose-send();
    callback compose-attach();
    callback compose-remove-attachment(int);
    callback compose-discard();
    callback compose-close();

    // Phones: one pane at a time (1 list, 2 message); folders are a drawer over them.
    property <bool> narrow: root.width < 700px;
    in-out property <bool> show-folders;
    property <int> pane: root.composing || root.has-message ? 2 : 1;

    // Always present, also under the setup screen: the webview must never be destroyed.
    keys := FocusScope {
        init => {
            self.focus();
        }
        property <bool> needs-setup: root.needs-setup;
        changed needs-setup => {
            if !self.needs-setup {
                self.focus();
            }
        }
        // The compose fields held focus; take it back so keys (and Android Back) still work.
        property <bool> composing: root.composing;
        changed composing => {
            if !self.composing {
                self.focus();
            }
        }
        function select-relative(delta: int) {
            if root.messages.length == 0 {
                return;
            }
            root.message-selected(max(0, min(root.messages.length - 1, root.current-message + delta)));
            // Keep the selection in view.
            let row-top = root.current-message * 74px;
            if row-top < -message-list.content-y {
                message-list.content-y = -row-top;
            } else if row-top + 74px > -message-list.content-y + message-list.visible-height {
                message-list.content-y = -(row-top + 74px - message-list.visible-height);
            }
        }

        key-pressed(event) => {
            // Ctrl+U and Ctrl+P as in Thunderbird and browsers.
            if !root.needs-setup && !root.show-settings && !root.composing && event.modifiers.control && (event.text == "u" || event.text == "U") {
                root.view-source();
                return accept;
            }
            if !root.needs-setup && !root.show-settings && !root.composing && root.has-message && event.modifiers.control && (event.text == "p" || event.text == "P") {
                root.print();
                return accept;
            }
            if root.needs-setup || event.modifiers.control || event.modifiers.alt || event.modifiers.meta {
                return reject;
            }
            if root.show-settings {
                if event.text == Key.Back || event.text == Key.Escape {
                    root.show-settings = false;
                    return accept;
                }
                return reject;
            }
            if root.show-calendar {
                if event.text == Key.Back || event.text == Key.Escape {
                    if root.calendar-editing {
                        root.calendar-editing = false;
                    } else if root.calendar-showing-event {
                        root.calendar-showing-event = false;
                    } else {
                        root.show-calendar = false;
                    }
                    return accept;
                }
                return reject;
            }
            if event.text == "j" || event.text == Key.DownArrow {
                self.select-relative(1);
                return accept;
            }
            if event.text == "k" || event.text == Key.UpArrow {
                self.select-relative(-1);
                return accept;
            }
            if event.text == "c" {
                root.compose();
                return accept;
            }
            if event.text == "r" {
                root.reply();
                return accept;
            }
            if event.text == "a" {
                root.reply-all();
                return accept;
            }
            if event.text == "f" {
                root.forward();
                return accept;
            }
            // With rows ticked, these act on them.
            if event.text == "e" {
                if root.checked-count > 0 { root.bulk-action("archive"); } else { root.archive(); }
                return accept;
            }
            if event.text == "#" || event.text == Key.Delete {
                if root.checked-count > 0 { root.bulk-action("delete"); } else { root.delete(); }
                return accept;
            }
            if event.text == "z" && root.undo-text != "" {
                root.undo();
                return accept;
            }
            if event.text == "u" {
                if root.checked-count > 0 { root.bulk-action("seen"); } else { root.toggle-seen(); }
                return accept;
            }
            if event.text == "s" {
                if root.checked-count > 0 { root.bulk-action("flag"); } else { root.toggle-flag(); }
                return accept;
            }
            if event.text == "x" && root.current-message >= 0 {
                root.toggle-checked(root.current-message);
                return accept;
            }
            if event.text == "/" {
                search-box.focus();
                return accept;
            }
            if (event.text == Key.Back || event.text == Key.Escape) && root.source-open {
                root.view-source();
                return accept;
            }
            if event.text == Key.Back && root.checked-count > 0 && !root.has-message && !root.show-folders {
                root.bulk-action("clear");
                return accept;
            }
            // Android Back: leave the message or folder pane; unhandled at the top level, so Android closes the app.
            if event.text == Key.Back && (root.has-message || root.show-folders) {
                if root.has-message {
                    root.close-message();
                } else {
                    root.show-folders = false;
                }
                return accept;
            }
            if event.text == Key.Escape && root.checked-count > 0 {
                root.bulk-action("clear");
                return accept;
            }
            if event.text == Key.Escape {
                search-box.text = "";
                root.search("");
                self.focus();
                return accept;
            }
            reject
        }

        VerticalLayout {
            // Fixed position: the panes size from the window, not the other way round.
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            padding-top: root.safe-area-insets.top;
            padding-bottom: root.safe-area-insets.bottom;
            padding-left: root.safe-area-insets.left;
            padding-right: root.safe-area-insets.right;
            HorizontalLayout {
                // ---- folders ----
                // Space for the sidebar, which is drawn over it below (a drawer on phones).
                Rectangle {
                    width: root.narrow ? 0px : 200px;
                }

                Divider {
                    width: root.narrow ? 0px : 1px;
                }

                // ---- message list ----
                Rectangle {
                        width: root.narrow ? (root.pane == 1 ? root.width : 0px) : 340px;
                    clip: true;
                    VerticalLayout {
                        HorizontalLayout {
                            padding: 10px;
                            spacing: 6px;
                            if root.narrow: ToolButton {
                                text: "Folders";
                                icon: @image-url("icons/menu.svg");
                                show-text: false;
                                clicked => {
                                    root.show-folders = true;
                                    // So Back closes the drawer instead of the app.
                                    keys.focus();
                                }
                            }
                            search-box := TextField {
                                label: "Search";
                                text <=> root.search-text;
                                placeholder: "Search mail  ( / )";
                                edited(text) => root.search(text);
                                accepted => keys.focus();
                            }
                            ToolButton {
                                text: "Sync";
                                icon: @image-url("icons/refresh-cw.svg");
                                show-text: false;
                                clicked => root.refresh();
                            }
                        }
                        if root.checked-count == 0: HorizontalLayout {
                            padding-left: 12px;
                            padding-bottom: 6px;
                            Text {
                                text: root.list-title;
                                font-weight: 600;
                                font-size: 15px;
                                overflow: elide;
                            }
                        }
                        // Actions on the ticked rows replace the title while any are ticked.
                        if root.checked-count > 0: HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 2px;
                            ToolButton {
                                text: "Clear selection";
                                icon: @image-url("icons/x.svg");
                                show-text: false;
                                clicked => root.bulk-action("clear");
                            }
                            Text {
                                text: root.checked-count + " selected";
                                font-weight: 600;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            ToolButton {
                                text: root.checked-all-seen ? "Mark selected unread" : "Mark selected read";
                                icon: root.checked-all-seen ? @image-url("icons/mail.svg") : @image-url("icons/mail-open.svg");
                                show-text: false;
                                clicked => root.bulk-action("seen");
                            }
                            ToolButton {
                                text: root.checked-all-flagged ? "Unflag selected" : "Flag selected";
                                icon: @image-url("icons/star.svg");
                                icon-color: root.checked-all-flagged ? Theme.flag : Palette.foreground;
                                show-text: false;
                                clicked => root.bulk-action("flag");
                            }
                            ToolButton {
                                text: "Archive selected";
                                icon: @image-url("icons/archive.svg");
                                show-text: false;
                                clicked => root.bulk-action("archive");
                            }
                            ToolButton {
                                text: "Delete selected";
                                icon: @image-url("icons/trash.svg");
                                show-text: false;
                                clicked => root.bulk-action("delete");
                            }
                        }
                        Divider {
                            height: 1px;
                        }
                        // Phones: pulling the list down from its top syncs.
                        pull := SwipeGestureHandler {
                            enabled: root.narrow && message-list.content-y >= 0;
                            handle-swipe-down: true;
                            vertical-stretch: 1;
                            property <length> distance: self.swiping ? min(self.current-position.y - self.pressed-position.y, 120px) : 0;
                            swiped => {
                                if self.current-position.y - self.pressed-position.y > 80px {
                                    root.refresh();
                                }
                            }
                            message-list := ListView {
                                width: 100%;
                                height: 100%;
                                changed content-y => {
                                    if -self.content-y + self.visible-height > self.content-height - 600px {
                                        root.load-older();
                                    }
                                }
                                for msg[i] in root.messages: MessageRow {
                                    msg: msg;
                                    selected: i == root.current-message;
                                    thread: root.conversation;
                                    thread-current: root.highlighted-in-conversation;
                                    selecting: root.checked-count > 0;
                                    swipeable: root.narrow;
                                    swiped(archive) => { root.row-swiped(i, archive); }
                                    clicked => {
                                        // Phones: while ticking, a tap ticks too.
                                        if root.narrow && root.checked-count > 0 {
                                            root.toggle-checked(i);
                                        } else {
                                            root.message-selected(i);
                                        }
                                        keys.focus();
                                    }
                                    held => { root.row-held(); }
                                    check-toggled => {
                                        root.toggle-checked(i);
                                        keys.focus();
                                    }
                                    thread-clicked(j) => {
                                        root.conversation-selected(j);
                                        keys.focus();
                                    }
                                }
                            }
                            if root.narrow && (pull.distance > 0 || root.syncing): Rectangle {
                                x: (parent.width - self.width) / 2;
                                y: root.syncing ? 16px : pull.distance / 2 - 20px;
                                width: 40px;
                                height: 40px;
                                border-radius: 20px;
                                background: Palette.alternate-background;
                                drop-shadow-blur: 4px;
                                drop-shadow-color: #00000040;
                                Image {
                                    width: 22px;
                                    source: @image-url("icons/refresh-cw.svg");
                                    colorize: Theme.accent;
                                    opacity: root.syncing || pull.distance > 80px ? 1 : 0.5;
                                    // Follows the finger while pulling, then spins once a turn per second.
                                    transform-rotation: root.syncing ? (animation-tick() / 1ms).mod(1000) * 0.36deg : pull.distance / 120px * 270deg;
                                }
                            }
                        }
                        if root.messages.length == 0: Rectangle {
                            vertical-stretch: 1;
                            Text {
                                text: root.searching ? "No matches" : "No messages";
                                color: Theme.muted;
                            }
                        }
                    }
                }

                Divider {
                    width: root.narrow ? 0px : 1px;
                }

                // ---- reader ----
                Rectangle {
                        width: root.narrow ? (root.pane == 2 ? root.width : 0px) : root.width - 542px;
                    clip: true;
                    VerticalLayout {
                        if root.composing: ComposeView {
                            vertical-stretch: 1;
                            to <=> root.compose-to;
                            cc <=> root.compose-cc;
                            bcc <=> root.compose-bcc;
                            subject <=> root.compose-subject;
                            body <=> root.compose-body;
                            attachments: root.compose-attachments;
                            sending: root.compose-sending;
                            error: root.compose-error;
                            from-options: root.compose-from-options;
                            from-index <=> root.compose-from-index;
                            send => root.compose-send();
                            attach => root.compose-attach();
                            remove-attachment(i) => root.compose-remove-attachment(i);
                            discard => root.compose-discard();
                            close => root.compose-close();
                        }
                        if !root.has-message && !root.narrow && !root.composing: Rectangle {
                            vertical-stretch: 1;
                            Text {
                                text: "No message selected";
                                color: Theme.muted;
                            }
                        }
                        if root.has-message && !root.composing: VerticalLayout {
                            padding: 14px;
                            padding-bottom: 8px;
                            spacing: 6px;
                            HorizontalLayout {
                                spacing: 2px;
                                // Labels only when the reader is wide enough; icons alone on phones.
                                property <bool> labels: !root.narrow && root.width >= 1250px;
                                if root.narrow: ToolButton {
                                    text: "Back";
                                    icon: @image-url("icons/arrow-left.svg");
                                    show-text: false;
                                    clicked => root.close-message();
                                }
                                if root.msg-is-draft: ToolButton {
                                    text: "Edit draft";
                                    icon: @image-url("icons/file-pen-line.svg");
                                    show-text: true;
                                    clicked => root.edit-draft();
                                }
                                ToolButton {
                                    text: "Reply";
                                    icon: @image-url("icons/reply.svg");
                                    show-text: parent.labels;
                                    clicked => root.reply();
                                }
                                ToolButton {
                                    text: "Reply all";
                                    icon: @image-url("icons/reply-all.svg");
                                    show-text: parent.labels;
                                    clicked => root.reply-all();
                                }
                                ToolButton {
                                    text: "Forward";
                                    icon: @image-url("icons/forward.svg");
                                    show-text: parent.labels;
                                    clicked => root.forward();
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                }
                                ToolButton {
                                    text: root.msg-flagged ? "Unflag" : "Flag";
                                    icon: @image-url("icons/star.svg");
                                    show-text: false;
                                    icon-color: root.msg-flagged ? Theme.flag : Palette.foreground;
                                    clicked => root.toggle-flag();
                                }
                                ToolButton {
                                    text: root.msg-seen ? "Mark unread" : "Mark read";
                                    icon: root.msg-seen ? @image-url("icons/mail.svg") : @image-url("icons/mail-open.svg");
                                    show-text: false;
                                    clicked => root.toggle-seen();
                                }
                                // Phones leave room for the draft's labelled Edit button.
                                if !root.narrow || !root.msg-is-draft: ToolButton {
                                    text: root.tools-open ? "Fewer tools" : "More tools";
                                    icon: @image-url("icons/ellipsis.svg");
                                    show-text: false;
                                    icon-color: root.tools-open ? Theme.accent : Palette.foreground;
                                    clicked => { root.tools-open = !root.tools-open; }
                                }
                                // Phones have these in the thumb bar at the bottom.
                                if !root.narrow: ToolButton {
                                    text: "Archive";
                                    icon: @image-url("icons/archive.svg");
                                    show-text: parent.labels;
                                    clicked => root.archive();
                                }
                                if !root.narrow: ToolButton {
                                    text: "Delete";
                                    icon: @image-url("icons/trash.svg");
                                    show-text: parent.labels;
                                    clicked => root.delete();
                                }
                            }
                            // In the layout rather than a popup: Android's native message view would cover a popup.
                            if root.tools-open: HorizontalLayout {
                                spacing: 2px;
                                ToolButton {
                                    text: root.source-open ? "Hide source" : "View source";
                                    short-text: root.source-open ? "Message" : "Source";
                                    icon: @image-url("icons/code.svg");
                                    icon-color: root.source-open ? Theme.accent : Palette.foreground;
                                    clicked => root.view-source();
                                }
                                ToolButton {
                                    text: "Save as .eml";
                                    short-text: root.narrow ? ".eml" : "";
                                    icon: @image-url("icons/download.svg");
                                    clicked => root.save-eml();
                                }
                                ToolButton {
                                    text: "Save as PDF";
                                    short-text: root.narrow ? "PDF" : "";
                                    icon: @image-url("icons/file-down.svg");
                                    clicked => root.save-pdf();
                                }
                                ToolButton {
                                    text: "Print";
                                    icon: @image-url("icons/printer.svg");
                                    clicked => root.print();
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                }
                            }
                            Text {
                                text: root.msg-subject;
                                font-size: 19px;
                                font-weight: 600;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                // The sender is a link to all of their mail.
                                Text {
                                    text: root.msg-from;
                                    font-weight: 600;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                    color: sender-touch.has-hover ? Theme.accent : Palette.foreground;
                                    animate color { duration: 120ms; }
                                    sender-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        accessible-role: button;
                                        accessible-label: "More from this sender";
                                        accessible-action-default => { self.clicked(); }
                                        clicked => {
                                            root.show-sender();
                                            // Phones show the results in the list pane.
                                            if root.narrow {
                                                root.close-message();
                                            }
                                        }
                                    }
                                }
                                Text {
                                    text: root.msg-date;
                                    color: Theme.muted;
                                }
                            }
                            Text {
                                text: "To: " + root.msg-to + (root.msg-cc != "" ? "   Cc: " + root.msg-cc : "");
                                color: Theme.muted;
                                font-size: 12px;
                                overflow: elide;
                            }
                            if root.invite-kind != "": Rectangle {
                                border-radius: 6px;
                                background: Palette.foreground.with-alpha(0.06);
                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 4px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Image {
                                            source: @image-url("icons/calendar.svg");
                                            colorize: Theme.accent;
                                            width: 16px;
                                        }
                                        Text {
                                            text: root.invite-title;
                                            font-weight: 600;
                                            wrap: word-wrap;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                    Text {
                                        text: root.invite-when;
                                        wrap: word-wrap;
                                    }
                                    if root.invite-where != "": Text {
                                        text: root.invite-where;
                                        color: Theme.muted;
                                        wrap: word-wrap;
                                    }
                                    if root.invite-detail != "": Text {
                                        text: root.invite-detail;
                                        color: Theme.muted;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                    if root.invite-kind == "REQUEST": HorizontalLayout {
                                        alignment: start;
                                        spacing: 6px;
                                        Button {
                                            text: "Accept";
                                            primary: true;
                                            clicked => root.invite-respond("ACCEPTED");
                                        }
                                        Button {
                                            text: "Maybe";
                                            clicked => root.invite-respond("TENTATIVE");
                                        }
                                        Button {
                                            text: "Decline";
                                            clicked => root.invite-respond("DECLINED");
                                        }
                                    }
                                    if root.invite-kind == "PUBLISH": HorizontalLayout {
                                        alignment: start;
                                        Button {
                                            text: "Add to calendar";
                                            clicked => root.invite-respond("ADD");
                                        }
                                    }
                                    if root.invite-kind == "CANCEL": HorizontalLayout {
                                        alignment: start;
                                        Button {
                                            text: "Remove from calendar";
                                            clicked => root.invite-respond("REMOVE");
                                        }
                                    }
                                }
                            }
                            // Phones hide the list, so the conversation's timeline moves into the reader.
                            if root.narrow && root.conversation.length > 1: ListView {
                                height: min(root.conversation.length, 4) * 30px;
                                vertical-stretch: 0;
                                // Keeps the open entry in view, with the one before it for context.
                                property <int> current: root.highlighted-in-conversation;
                                function reveal() {
                                    self.viewport-y = -max(0, min(self.current - 1, root.conversation.length - 4)) * 30px;
                                }
                                init => { self.reveal(); }
                                changed current => { self.reveal(); }
                                for item[i] in root.conversation: TimelineItem {
                                    item: item;
                                    current: i == root.highlighted-in-conversation;
                                    first: i == 0;
                                    last: i == root.conversation.length - 1;
                                    line-color: Theme.accent;
                                    clicked => root.conversation-selected(i);
                                }
                            }
                            if root.msg-attachments.length > 0: HorizontalLayout {
                                spacing: 6px;
                                for att in root.msg-attachments: Rectangle {
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: Theme.divider;
                                    height: 28px;
                                    min-width: att-chip.preferred-width;
                                    att-chip := HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 6px;
                                        Image {
                                            source: @image-url("icons/paperclip.svg");
                                            colorize: Theme.muted;
                                            width: 14px;
                                        }
                                        Text {
                                            text: att.name + "  " + att.size;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                        }
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => root.save-attachment(att.index);
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                }
                            }
                            if root.msg-remote-blocked: Rectangle {
                                border-radius: 6px;
                                background: Palette.foreground.with-alpha(0.06);
                                // The text wraps so the button stays on narrow screens.
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-top: 2px;
                                    padding-bottom: 2px;
                                    spacing: 10px;
                                    Image {
                                        source: @image-url("icons/image.svg");
                                        colorize: Theme.muted;
                                        width: 16px;
                                    }
                                    Text {
                                        text: "Remote images are blocked to protect your privacy.";
                                        vertical-alignment: center;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                        horizontal-stretch: 1;
                                    }
                                    ToolButton {
                                        text: "Load images";
                                        clicked => root.load-remote-images();
                                    }
                                }
                            }
                        }
                        Divider {
                            height: 1px;
                            visible: root.has-message && !root.composing;
                        }
                        html-area := Rectangle {
                            vertical-stretch: root.has-message && !root.composing ? 1 : 0;
                            // The hidden webview's rendered page would otherwise claim its height and squash the composer.
                            preferred-height: 0px;
                            // The webview stays alive for the whole session; Servo
                            // renders into it, so it is only hidden, never destroyed.
                            if root.use-webview: Webview {
                                width: 100%;
                                height: 100%;
                                visible: root.has-message && !root.composing && !root.source-open;
                                scrolled => { root.reader-scrolled = true; }
                            }
                            if root.source-open && root.has-message && !root.composing: TextEdit {
                                accessible-label: "Message source";
                                width: 100%;
                                height: 100%;
                                read-only: true;
                                wrap: no-wrap;
                                font-size: 12px;
                                text: root.msg-source;
                            }
                            if !root.use-webview && !root.html-overlay && !root.source-open && root.has-message && !root.composing: reader-scroll := ScrollView {
                                scrolled => { root.reader-scrolled = true; }
                                VerticalLayout {
                                    width: reader-scroll.visible-width;
                                    padding: 14px;
                                    padding-top: 12px;
                                    spacing: 18px;
                                    for part[i] in root.msg-parts: part-row := HorizontalLayout {
                                        spacing: 8px;
                                        // The reading line, as in the HTML reader (mailcore::mime::SCROLLED_SCRIPT): it moves
                                        // from the viewport's top to its bottom as the reader scrolls from start to end.
                                        property <length> line: -reader-scroll.content-y * (1 + reader-scroll.visible-height / max(1px, reader-scroll.content-height - reader-scroll.visible-height));
                                        // Each message owns the gap after it; the first also what comes before.
                                        property <bool> on-line: (i == 0 || self.y <= self.line) && (i == root.msg-parts.length - 1 || self.line < self.y + self.height + 18px);
                                        property <bool> spied: root.reader-scrolled && self.on-line;
                                        changed spied => {
                                            if self.spied {
                                                root.scrolled-in-conversation = i;
                                            }
                                        }
                                        // Scrolls to the open message once laid out; Rust sets a new model on every
                                        // render, so this runs again for each opened message.
                                        Timer {
                                            interval: 1ms;
                                            running: i == root.current-in-conversation;
                                            triggered => {
                                                reader-scroll.viewport-y = -part-row.y;
                                                self.running = false;
                                            }
                                        }
                                        // Marks the open message, or the scrolled-to one, like the Servo reader.
                                        if root.msg-parts.length > 1: Rectangle {
                                            width: 3px;
                                            background: i == root.highlighted-in-conversation ? Theme.accent : Theme.divider;
                                        }
                                        VerticalLayout {
                                            spacing: 8px;
                                            if part.heading != "": Text {
                                                text: part.heading;
                                                color: Theme.muted;
                                                font-size: 12px;
                                                wrap: word-wrap;
                                            }
                                            Text {
                                                text: part.text;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }
                                }
                            }
                            if root.msg-loading: Spinner {
                                indeterminate: true;
                                width: 32px;
                                height: 32px;
                            }
                            // Floating variant of the thumb bar: stacked in the thumb's corner, Next lowest.
                            if root.narrow && root.has-message && !root.composing && root.floating && !root.html-visible: VerticalLayout {
                                // Unsized children fill their parent; keep the column at its natural size.
                                width: self.preferred-width;
                                height: self.preferred-height;
                                x: root.left-handed ? 16px : parent.width - self.width - 16px;
                                y: parent.height - self.height - 16px;
                                spacing: 12px;
                                FloatButton {
                                    text: "Delete";
                                    icon: @image-url("icons/trash.svg");
                                    clicked => root.delete();
                                }
                                FloatButton {
                                    text: "Archive";
                                    icon: @image-url("icons/archive.svg");
                                    clicked => root.archive();
                                }
                                FloatButton {
                                    text: "Next";
                                    icon: @image-url("icons/arrow-down.svg");
                                    clicked => keys.select-relative(1);
                                }
                            }
                        }
                        // ---- thumb bar (phones) ----
                        // Mirrored by hand, with Next nearest the edge where the thumb rests.
                        if root.narrow && root.has-message && !root.composing && !root.floating: Divider {
                            height: 1px;
                        }
                        if root.narrow && root.has-message && !root.composing && !root.floating: HorizontalLayout {
                            padding: 6px;
                            spacing: 8px;
                            Rectangle {
                                horizontal-stretch: root.left-handed ? 0 : 1;
                            }
                            if root.left-handed: ToolButton {
                                text: "Next";
                                icon: @image-url("icons/arrow-down.svg");
                                height: 48px;
                                min-width: 56px;
                                clicked => keys.select-relative(1);
                            }
                            if !root.left-handed: ToolButton {
                                text: "Delete";
                                icon: @image-url("icons/trash.svg");
                                show-text: false;
                                height: 48px;
                                min-width: 56px;
                                clicked => root.delete();
                            }
                            ToolButton {
                                text: "Archive";
                                icon: @image-url("icons/archive.svg");
                                show-text: false;
                                height: 48px;
                                min-width: 56px;
                                clicked => root.archive();
                            }
                            if root.left-handed: ToolButton {
                                text: "Delete";
                                icon: @image-url("icons/trash.svg");
                                show-text: false;
                                height: 48px;
                                min-width: 56px;
                                clicked => root.delete();
                            }
                            if !root.left-handed: ToolButton {
                                text: "Next";
                                icon: @image-url("icons/arrow-down.svg");
                                height: 48px;
                                min-width: 56px;
                                clicked => keys.select-relative(1);
                            }
                            Rectangle {
                                horizontal-stretch: root.left-handed ? 1 : 0;
                            }
                        }
                    }
                }
            }

            // ---- status bar ----
            Divider {
                height: 1px;
            }
            HorizontalLayout {
                // Taller while Undo is offered: a finger-sized button.
                height: root.undo-text != "" ? 36px : 24px;
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;
                if root.undo-text != "": Text {
                    text: root.undo-text;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                if root.undo-text != "": ToolButton {
                    text: "Undo";
                    clicked => { root.undo(); }
                }
                if root.undo-text == "": Text {
                    text: root.status;
                    color: Theme.muted;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.version;
                    color: Theme.muted;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                if root.has-account: Text {
                    text: root.online ? "● Online" : "○ Offline";
                    color: root.online ? #3a3 : Theme.muted;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }

            // Phones: tapping outside the drawer closes it.
            Rectangle {
                background: #0008;
                opacity: root.narrow && root.show-folders ? 1 : 0;
                animate opacity { duration: 200ms; }
                TouchArea {
                    enabled: root.narrow && root.show-folders;
                    clicked => { root.show-folders = false; }
                }
            }
            // ---- folders ----
            // Phones: a drawer covering 90% of the width, so the list stays visible behind it.
            Rectangle {
                width: root.narrow ? root.width * 0.9 : 200px;
                height: root.narrow ? root.height : root.height - root.safe-area-insets.top - root.safe-area-insets.bottom - 25px;
                x: root.narrow ? (root.show-folders ? 0px : -self.width) : root.safe-area-insets.left;
                y: root.narrow ? 0px : root.safe-area-insets.top;
                animate x { duration: 200ms; easing: ease-out; }
                clip: true;
                background: Theme.sidebar;
                VerticalLayout {
                    padding: 10px;
                    padding-top: 10px + (root.narrow ? root.safe-area-insets.top : 0px);
                    padding-bottom: 10px + (root.narrow ? root.safe-area-insets.bottom : 0px);
                    padding-left: 10px + (root.narrow ? root.safe-area-insets.left : 0px);
                    spacing: 8px;
                    Button {
                        text: "New message";
                        icon: @image-url("icons/square-pen.svg");
                        colorize-icon: true;
                        primary: true;
                        clicked => {
                            // Phones: after sending, return to the list, not the folder pane.
                            root.show-folders = false;
                            root.compose();
                        }
                    }
                    if root.has-account: ToolButton {
                        text: "Calendar";
                        icon: @image-url("icons/calendar.svg");
                        clicked => {
                            root.show-folders = false;
                            root.open-calendar();
                        }
                    }
                    ListView {
                        for folder[i] in root.folders: FolderRow {
                            folder: folder;
                            selected: i == root.current-folder && !root.searching;
                            clicked => {
                                root.show-folders = false;
                                root.folder-selected(i);
                                keys.focus();
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        Text {
                            text: root.account-label;
                            color: Theme.muted;
                            font-size: 12px;
                            overflow: elide;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        if root.has-account: ToolButton {
                            text: "Settings";
                            clicked => {
                                root.show-folders = false;
                                root.show-settings = true;
                            }
                        }
                    }
                }
            }
    }

    if root.show-settings: SettingsView {
        theme <=> root.theme;
        notifications <=> root.notifications;
        always-load-images <=> root.always-load-images;
        show-link-targets <=> root.show-link-targets;
        left-handed <=> root.left-handed;
        floating-buttons <=> root.floating-buttons;
        accounts: root.accounts;
        composing: root.composing;
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        changed => root.settings-changed();
        add-account => root.add-account();
        edit-account(i) => root.edit-account(i);
        remove-account(i) => root.remove-account(i);
        close => {
            root.show-settings = false;
            keys.focus();
        }
    }

    if root.show-calendar: CalendarView {
        // Fixed geometry: the page must not size the window, which decides `narrow`.
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        view <=> root.calendar-view;
        period-label: root.calendar-period-label;
        days: root.calendar-days;
        columns: root.calendar-columns;
        selected: root.calendar-selected;
        day-label: root.calendar-day-label;
        agenda: root.calendar-agenda;
        editing <=> root.calendar-editing;
        showing-event <=> root.calendar-showing-event;
        detail: root.event-detail;
        confirm-delete <=> root.calendar-confirm-delete;
        form <=> root.event-form;
        form-existing: root.event-form-existing;
        from-options: root.event-from-options;
        from-index <=> root.event-from-index;
        error: root.event-error;
        sync-error: root.calendar-error;
        attendees: root.event-attendees;
        add-attendee(text) => { return root.calendar-add-attendee(text); }
        remove-attendee(i) => root.calendar-remove-attendee(i);
        narrow: root.narrow;
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        set-view(v) => root.calendar-set-view(v);
        shift(n) => root.calendar-shift(n);
        today => root.calendar-today();
        day-clicked(i) => root.calendar-day-clicked(i);
        event-clicked(id) => root.calendar-event-clicked(id);
        edit-event => root.calendar-edit-event();
        delete-event => root.calendar-delete-event();
        new-event => root.calendar-new-event();
        save-event => root.calendar-save-event();
        refresh => root.calendar-refresh();
        close => {
            root.show-calendar = false;
            keys.focus();
        }
    }

    if root.needs-setup: SetupView {
        data <=> root.setup;
        error: root.setup-error;
        busy: root.setup-busy;
        can-cancel: root.has-account;
        editing: root.setup-editing;
        email-edited(t) => root.setup-email-edited(t);
        submit => root.setup-submit();
        cancel => root.setup-cancel();
    }
}
