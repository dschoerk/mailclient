// Small building blocks shared by every view.

import { LineEdit, Palette } from "std-widgets.slint";

export global Theme {
    out property <brush> accent: #2f6fde;
    out property <brush> unread-dot: #2f6fde;
    out property <brush> flag: #e8a317;
    out property <brush> muted: Palette.foreground.with-alpha(0.6);
    /// Hint text in empty fields: clearly weaker than anything typed.
    out property <brush> placeholder: Palette.foreground.with-alpha(0.35);
    /// Where the widget style starts a field's text: Fluent (desktop) 12px; set to Material's
    /// 16px on Android at startup.
    in-out property <length> text-inset: 12px;
    out property <brush> divider: Palette.border;
    out property <brush> selection: Palette.selection-background;
    out property <brush> sidebar: Palette.alternate-background;
}

export component Divider inherits Rectangle {
    background: Theme.divider;
}

/// Flat button with an icon (Lucide SVG) and an optional visible label. The label is
/// always the accessible name, so screen readers and tests see words, not pictures.
export component ToolButton inherits Rectangle {
    in property <string> text;
    /// Shown instead of `text` where room is short; `text` stays the accessible name.
    in property <string> short-text;
    in property <image> icon;
    in property <bool> show-text: true;
    in property <brush> icon-color: Palette.foreground;
    in property <bool> enabled: true;
    /// Marks the current choice among several buttons (calendar Month / Week / Day).
    in property <bool> checked;
    callback clicked();
    accessible-role: button;
    accessible-label: root.text;
    accessible-checked: root.checked;
    accessible-action-default => { root.clicked(); }
    height: 32px;
    min-width: content.preferred-width;
    border-radius: 6px;
    background: !root.enabled ? transparent : root.checked ? Theme.accent.with-alpha(touch.has-hover ? 0.22 : 0.15) : touch.pressed ? Palette.foreground.with-alpha(0.15) : touch.has-hover ? Palette.foreground.with-alpha(0.08) : transparent;
    // Press lands instantly, release and hover fade: feedback must never lag the finger.
    animate background { duration: touch.pressed ? 0ms : 150ms; easing: ease-out; }
    transform-scale: touch.pressed ? 0.94 : 1.0;
    animate transform-scale { duration: touch.pressed ? 60ms : 220ms; easing: touch.pressed ? ease-out : ease-out-back; }
    content := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        alignment: center;
        if root.icon.width > 0: Image {
            source: root.icon;
            colorize: root.enabled ? root.icon-color : Theme.muted;
            width: 18px;
        }
        if root.show-text || root.icon.width == 0: Text {
            text: root.short-text != "" ? root.short-text : root.text;
            color: root.enabled ? Palette.foreground : Theme.muted;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => root.clicked();
    }
}

/// Round icon button that floats over content (phone reader actions).
export component FloatButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    callback clicked();
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    width: 56px;
    height: 56px;
    border-radius: self.width / 2;
    background: touch.pressed ? Palette.alternate-background : Palette.background;
    animate background { duration: touch.pressed ? 0ms : 150ms; easing: ease-out; }
    border-width: 1px;
    border-color: Theme.divider;
    // Pressed, the button sinks: smaller, with a tighter shadow.
    transform-scale: touch.pressed ? 0.92 : touch.has-hover ? 1.05 : 1.0;
    animate transform-scale { duration: touch.pressed ? 60ms : 220ms; easing: touch.pressed ? ease-out : ease-out-back; }
    drop-shadow-blur: touch.pressed ? 3px : touch.has-hover ? 12px : 8px;
    drop-shadow-offset-y: touch.pressed ? 1px : touch.has-hover ? 4px : 2px;
    animate drop-shadow-blur, drop-shadow-offset-y { duration: 150ms; easing: ease-out; }
    drop-shadow-color: #00000040;
    Image {
        source: root.icon;
        colorize: Palette.foreground;
        width: 22px;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => root.clicked();
    }
}

/// A LineEdit with a quieter placeholder. The styles' own (Fluent's is 79% of the text color)
/// reads like a real value, and no style lets it be changed, so it is drawn here instead.
export component TextField inherits Rectangle {
    in-out property <string> text <=> edit.text;
    in property <string> placeholder;
    /// The accessible label, which tests and screen readers find the field by.
    in property <string> label;
    in property <InputType> input-type: InputType.text;
    in property <bool> read-only;
    in property <bool> enabled: true;
    callback edited(string);
    callback accepted(string);
    forward-focus: edit;
    min-width: edit.min-width;
    min-height: edit.min-height;
    preferred-width: edit.preferred-width;
    preferred-height: edit.preferred-height;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    edit := LineEdit {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        accessible-label: root.label;
        accessible-placeholder-text: root.placeholder;
        input-type: root.input-type;
        read-only: root.read-only;
        enabled: root.enabled;
        edited(text) => root.edited(text);
        accepted(text) => root.accepted(text);
    }
    if root.text == "": Text {
        x: Theme.text-inset;
        width: parent.width - 2 * Theme.text-inset;
        height: parent.height;
        text: root.placeholder;
        font-size: edit.font-size;
        color: Theme.placeholder;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component Field inherits HorizontalLayout {
    in property <string> label;
    in-out property <string> text;
    in property <string> placeholder;
    in property <InputType> input-type: InputType.text;
    in property <bool> read-only;
    callback edited(string);
    spacing: 8px;
    Text {
        text: root.label;
        width: 90px;
        vertical-alignment: center;
        horizontal-alignment: right;
        color: Theme.muted;
    }
    TextField {
        label: root.label;
        text <=> root.text;
        placeholder: root.placeholder;
        input-type: root.input-type;
        read-only: root.read-only;
        edited(t) => root.edited(t);
    }
}
