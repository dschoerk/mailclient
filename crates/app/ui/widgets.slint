// Small building blocks shared by every view.

import { LineEdit, Palette } from "std-widgets.slint";

export global Theme {
    out property <brush> accent: #2f6fde;
    out property <brush> unread-dot: #2f6fde;
    out property <brush> flag: #e8a317;
    out property <brush> muted: Palette.foreground.with-alpha(0.6);
    out property <brush> divider: Palette.border;
    out property <brush> selection: Palette.selection-background;
    out property <brush> sidebar: Palette.alternate-background;
}

export component Divider inherits Rectangle {
    background: Theme.divider;
}

/// Flat button with an icon (Lucide SVG) and an optional visible label. The label is
/// always the accessible name, so screen readers and tests see words, not pictures.
export component ToolButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> show-text: true;
    in property <brush> icon-color: Palette.foreground;
    in property <bool> enabled: true;
    callback clicked();
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    height: 32px;
    min-width: content.preferred-width;
    border-radius: 6px;
    background: !root.enabled ? transparent : touch.pressed ? Palette.foreground.with-alpha(0.15) : touch.has-hover ? Palette.foreground.with-alpha(0.08) : transparent;
    content := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        alignment: center;
        if root.icon.width > 0: Image {
            source: root.icon;
            colorize: root.enabled ? root.icon-color : Theme.muted;
            width: 18px;
        }
        if root.show-text || root.icon.width == 0: Text {
            text: root.text;
            color: root.enabled ? Palette.foreground : Theme.muted;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => root.clicked();
    }
}

/// Round icon button that floats over content (phone reader actions).
export component FloatButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    callback clicked();
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    width: 56px;
    height: 56px;
    border-radius: self.width / 2;
    background: touch.pressed ? Palette.alternate-background : Palette.background;
    border-width: 1px;
    border-color: Theme.divider;
    drop-shadow-blur: 8px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: #00000040;
    Image {
        source: root.icon;
        colorize: Palette.foreground;
        width: 22px;
    }
    touch := TouchArea {
        clicked => root.clicked();
    }
}

export component Field inherits HorizontalLayout {
    in property <string> label;
    in-out property <string> text;
    in property <string> placeholder;
    in property <InputType> input-type: InputType.text;
    callback edited(string);
    spacing: 8px;
    Text {
        text: root.label;
        width: 90px;
        vertical-alignment: center;
        horizontal-alignment: right;
        color: Theme.muted;
    }
    LineEdit {
        accessible-label: root.label;
        text <=> root.text;
        placeholder-text: root.placeholder;
        input-type: root.input-type;
        edited(t) => root.edited(t);
    }
}
