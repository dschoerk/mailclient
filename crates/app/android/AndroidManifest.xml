<?xml version="1.0" encoding="utf-8"?>
<!-- Used by scripts/build-android.sh instead of the manifest cargo-apk writes, which can declare
     neither our own activity class nor a service. VERSION_CODE/VERSION_NAME/DEBUGGABLE come from cargo-apk's. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.mailclient.app"
    android:versionCode="VERSION_CODE" android:versionName="VERSION_NAME">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="35"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Keeps the periodic mail check scheduled across reboots. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Remote images in mail are often plain http; the HTML view loads them only once the user allows it. -->
    <application android:label="Mail" android:hasCode="true" android:debuggable="DEBUGGABLE" android:usesCleartextTraffic="true">
        <activity android:name="dev.mailclient.MainActivity" android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize">
            <meta-data android:name="android.app.lib_name" android:value="mailclient_app"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Own process: the background check sets up the Rust side's Android context, which the UI's would clash with. -->
        <service android:name="dev.mailclient.SyncJob" android:exported="false" android:process=":sync"
            android:permission="android.permission.BIND_JOB_SERVICE"/>
    </application>
</manifest>
